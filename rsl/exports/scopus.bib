@CONFERENCE{Sharma2026,
	author = {Sharma, Vikas and Vashishth, Tarun Kumar and Thakur, Anish and Chauhan, Puneet and Singh, Ankit and Kant, Ravi},
	title = {Deep Learning Based Intrusion Detection for Real Time Cyber Threat Mitigation},
	year = {2026},
	journal = {GSEACT 2026 - 2026 IEEE Global Symposium on Emerging and Communication Technologies},
	pages = {},
	doi = {10.1109/GSEACT68539.2026.11620589},
	url = {https://www.scopus.com/pages/publications/105047904662?origin=resultslist},
	abstract = {Intrusion Detection Systems (IDSs) continue to evolve using new technologies and methods as the number of connected systems, cloud computing platforms, and Internet of Things (IoT) grows at an astonishing rate. AWS-based and rule/ signature-based IDSs continue to be the most common forms of intrusion detection, but they do not adapt as quickly to these new technologies and changing environments. In addition, they also have high rates of false positives and fail to provide adequate protection from zero-day attacks and evolving attack strategies due to their static nature. To address the limitations with traditional methodology of IDSs, a Real-time Mitigation of Cyber Threats using Deep Learning is proposed in this paper. The proposed model takes advantage of advanced deep learning technique to perform automatic extraction of discriminative features from network data without the need of manual feature extraction. The proposed Framework has been built to facilitate accurate identification of normal versus malicious actions with low latency so that it can be effectively implemented in a realtime or near real-time implementation. Performance results from numerous benchmark datasets prove that the proposed technique significantly improves detection accuracy, recall on a wider range of attacks, and greatly reduces false alarms when compared with traditional machine learning-based IDS techniques. This study is evidence of how deep learning techniques can be utilized to improve modern cybersecurity infrastructures through enhanced ability to detect malicious cyber activity rapidly and reliably. © 2026 IEEE.},
	author_keywords = {Anomaly Detection; Cyber Security; Deep Learning; Intrusion Detection; Network Security; Real-time Detection},
	keywords = {Anomaly detection; Benchmarking; Computer crime; Cybersecurity; Distributed computer systems; Extraction; Feature extraction; Intrusion detection; Learning algorithms; Learning systems; Network intrusion; Real time control; Zero-day attack; Anomaly detection; Cyber security; Cyber threats; Deep learning; Intrusion Detection Systems; Intrusion-Detection; Learning techniques; Networks security; Real- time; Real-time detection; Deep learning},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Das202040,
	author = {Das, Anurag and Ajila, Samuel A. and Lung, Chung-Horng},
	title = {A Comprehensive Analysis of Accuracies of Machine Learning Algorithms for Network Intrusion Detection},
