@ARTICLE{Vy2021131,
	author = {Vy, Nguyen Chi and Quyen, Nguyen Huu and Duy, Phan The and Pham, Van-Hau},
	title = {Federated Learning-Based Intrusion Detection in the Context of IIoT Networks: Poisoning Attack and Defense},
