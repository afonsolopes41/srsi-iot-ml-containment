	title = {Securing Symbiotic IoT in 6G Networks Using a Hybrid MCBA-6GNET Deep Learning Framework for Anomaly Detection},
	year = {2025},
	journal = {Transactions on Emerging Telecommunications Technologies},
	volume = {36},
	number = {10},
