@ARTICLE{Ahmad2026,
	author = {Ahmad, Jorair and Alduailij, Mai and Alfaidi, Arij and Alamoudi, Abdulrahman Mohammed and Elshafie, Hashim and Qamar, Shamimul},
	title = {Blockchain-secured machine learning intrusion detection for renewable energy smart grid: Supporting LFC and AVC continuity in fog IoT environments},
