@CONFERENCE{Shivaswamy20251637,
	author = {Shivaswamy, D. and Arun Kumar, B. and Prakash, B. and Shreyas, A.},
	title = {An Automated VAPT Framework for Smart Home IoT Environments: Protocol-Aware Vulnerability Detection and Mitigation},
	year = {2025},
	journal = {Proceedings of the 6th International Conference on Smart Electronics and Communication, ICOSEC 2025},
	pages = {1637 - 1645},
	doi = {10.1109/ICOSEC67334.2025.11459590},
	url = {https://www.scopus.com/pages/publications/105037160202?origin=resultslist},
	abstract = {The proliferation of Internet of Things (IoT) devices in smart homes has enhanced automation, comfort, and energy efficiency while simultaneously introducing significant security challenges arising from protocol vulnerabilities, weak firmware protections, and fragmented standards. This research presents ProVAPT SmartHome, an automated and protocol-aware Vulnerability Assessment and Penetration Testing (VAPT) framework specifically designed to secure smart home IoT ecosystems. Unlike traditional VAPT tools, ProVAPT combines dynamic protocol analysis, CVE-based vulnerability detection, and lightweight machine learning- driven behavioural anomaly identification within a Windows-based environment suitable for practical deployment in Indian households. The framework was evaluated using commonly available smart home devices such as Wi-Fi and ZigBee enabled smart bulbs, DLink IP cameras, and Xiaomi smart plugs, covering protocols including MQTT, CoAP, UPnP, and ZigBee. ProVAPT identified 17 vulnerabilities comprising 14 known CVEs and 3 previously undocumented zero-day flaws, achieving a true positive rate of 96.1 percent, a false positive rate of 3.8 percent, and an average detection latency of 6.2 seconds per device. Behavioral anomaly detection using an Isolation Forest model reached a precision of 93.7 percent and an F1-score of 93.1 percent, while real-time mitigation was performed through Windows native firewall rules with an 81 percent user confirmation rate. Through its modular architecture, native Windows compatibility, and user-centric mitigation dashboard, ProVAPT SmartHome provides a robust, scalable, and low-overhead solution for IoT threat detection and response, eliminating the need for specialized hardware or Linux systems and establishing a new direction in IoT cybersecurity by integrating protocol awareness, behavioural intelligence, and automated enforcement in a single deployable solution.  © 2025 IEEE.},
	author_keywords = {Automated Mitigation; Behavioral Anomaly Detection; CoAP Vulnerabilities; CVE Exploit Detection; Internet of Things (IoT); IoT Threat Intelligence; MQTT Security; Protocol Aware Detection; Smart Home Security; Vulnerability Assessment and Penetration Testing (VAPT); Windows-Based Framework; ZigBee Security},
