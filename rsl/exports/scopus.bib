@ARTICLE{Alzahrani2023,
	author = {Alzahrani, Rami J. and Alzahrani, Ahmed},
	title = {A Novel Multi Algorithm Approach to Identify Network Anomalies in the IoT Using Fog Computing and a Model to Distinguish between IoT and Non-IoT Devices},
