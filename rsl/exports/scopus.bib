@CONFERENCE{Galli2025219,
	author = {Galli, Dimitri and Venturi, Andrea and Stabili, Dario and Andreolini, Mauro and Marchetti, Mirco},
	title = {Defending Network Intrusion Detection Systems Based on Graph Neural Networks Against Structural Adversarial Attacks},
	year = {2025},
	journal = {Proceedings - 2025 23rd IEEE International Symposium on Network Computing and Applications, NCA 2025},
