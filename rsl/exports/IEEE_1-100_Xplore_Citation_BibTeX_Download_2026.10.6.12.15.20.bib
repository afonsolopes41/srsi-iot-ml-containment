  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11576803,
  author={Sujatha, R. and Nivishna, S. and N, Rani and P, Saranya and T, Sharumathi and J, Shibani},
  booktitle={2026 International Conference on Connected Intelligence for Industrial Applications (CI2A)}, 
  title={AI-Based Bird Intrusion Detection and Frequency-Adaptive Repelling System for Crop Protection}, 
  year={2026},
  volume={},
  number={},
  pages={1-5},
  abstract={Bird intrusion into agricultural farmlands results in significant crop losses, especially during the crucial growth and harvest stages. The traditional methods of bird deterrence, such as scarecrows, static sound emitters, and manual surveillance, tend to become ineffective as birds become habituated and lack adaptability. To address these challenges, an intelligent bird intrusion detection and frequency, adaptive repelling system is proposed that aims at automatically providing an efficient and environmentally friendly solution for crop protection in the fields. The system uses image recognition, based on deep learning algorithms, to detect and recognise birds in real time from visual data obtained through cameras in the fields. Once a bird is detected, the system generates on, demand species, specific acoustic frequencies and emits them locally through a sound emission module enabled by the Internet of Things (IoT). In contrast to conventional repellers that depend on fixed sound patterns, the adaptive frequency approach changes the acoustic signals according to the birds' response behaviour, thus reducing habituation and increasing the deterrence effectiveness over time. In fact, the whole system functions autonomously with very little human involvement, and it is amenable to being set up in villages. Field tests reveal that employing adaptive frequency modulation results in a more significant improvement of bird repelling effectiveness over static mitigation measures, while at the same time allowing an ethical, harm-free method. This system is a step forward in the development of smart agricultural guarding, which is achieved by the combination of artificial intelligence, adaptive acoustics, and IoT.},
  keywords={Birds;Internet of Things;Frequency;Timing;Signal detection;Crops;Deep learning;Real-time systems;Printing;Modeling;Bird Intrusion Detection;Deep Learning;Image Processing;Frequency-Adaptive Repelling;Internet of Things (IoT);Smart Agriculture;Crop Protection;Acoustic Deterrence},
  doi={10.1109/CI2A69097.2026.11576803},
  ISSN={},
  month={April},}@INPROCEEDINGS{10625054,
  author={H, Mangalam and H, Karun Harshaini and S, Kavya Shree S and P, Pavithran},
  booktitle={2024 2nd International Conference on Sustainable Computing and Smart Systems (ICSCSS)}, 
  title={Hybrid Modeling System for Photovoltaic Monitoring of Solar Panels}, 
  year={2024},
  volume={},
  number={},
  pages={38-42},
  abstract={Solar photovoltaic (PV) systems have emerged as a prominent source of clean and renewable electricity generation, yet their performance is influenced by various external factors. To effectively assess and optimize their performance, a real-time remote monitoring system is essential. This study proposes an Internet of Things (IoT)-based monitoring system for solar energy systems, aiming to enhance output efficiency by addressing factors such as panel connections and dust accumulation, which can significantly reduce output. The developed IoT system integrates physical modeling with machine learning to monitor and optimize PV system performance. A dedicated software platform enables hybrid modeling of expected versus actual power output, facilitating early anomaly detection and mitigation. Particularly in dusty environments where solar PV modules are commonly deployed, the system includes a cleaning mechanism to enhance module efficiency by removing accumulated dust. This research outlines the design, implementation, and testing of an affordable and effective PV monitoring solution. By accurately predicting electrical output and swiftly identifying performance deviations, the proposed system aims to maximize the efficiency and reliability of solar energy generation, contributing to sustainable energy practices.},
  keywords={System performance;Solar energy;Machine learning;Hybrid power systems;Cleaning;Reliability;Solar panels;Realtime;Remote Monitoring;Internet of Things;Hybrid;Physical Modeling;Machine Learning;Efficiency},
  doi={10.1109/ICSCSS60660.2024.10625054},
  ISSN={},
  month={July},}@INPROCEEDINGS{11620589,
  author={Sharma, Vikas and Chauhan, Puneet and Vashishth, Tarun Kumar and Singh, Ankit and Thakur, Anish and Kant, Ravi},
  booktitle={2026 IEEE Global Symposium on Emerging and Communication Technologies (GSEACT)}, 
  title={Deep Learning Based Intrusion Detection for Real Time Cyber Threat Mitigation}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Intrusion Detection Systems (IDSs) continue to evolve using new technologies and methods as the number of connected systems, cloud computing platforms, and Internet of Things (IoT) grows at an astonishing rate. AWS-based and rule/ signature-based IDSs continue to be the most common forms of intrusion detection, but they do not adapt as quickly to these new technologies and changing environments. In addition, they also have high rates of false positives and fail to provide adequate protection from zero-day attacks and evolving attack strategies due to their static nature. To address the limitations with traditional methodology of IDSs, a Real-time Mitigation of Cyber Threats using Deep Learning is proposed in this paper. The proposed model takes advantage of advanced deep learning technique to perform automatic extraction of discriminative features from network data without the need of manual feature extraction. The proposed Framework has been built to facilitate accurate identification of normal versus malicious actions with low latency so that it can be effectively implemented in a realtime or near real-time implementation. Performance results from numerous benchmark datasets prove that the proposed technique significantly improves detection accuracy, recall on a wider range of attacks, and greatly reduces false alarms when compared with traditional machine learning-based IDS techniques. This study is evidence of how deep learning techniques can be utilized to improve modern cybersecurity infrastructures through enhanced ability to detect malicious cyber activity rapidly and reliably.},
  keywords={Modeling;Deep learning;Intrusion detection;Timing;Conferences;Printing;Internet of Things;Telecommunication traffic;Training;Signal detection;Intrusion Detection;Deep Learning;Cyber Security;Real-time Detection;Network Security;Anomaly Detection},
  doi={10.1109/GSEACT68539.2026.11620589},
  ISSN={},
  month={June},}@INPROCEEDINGS{11502415,
  author={Alhaidari, Fahd and AlQahtani, Sarah and AlDossary, Noura and Zagrouba, Rachid},
  booktitle={2026 IEEE 15th International Conference on Communication Systems and Network Technologies (CSNT)}, 
  title={A Layered Machine Learning and Smart Contract Framework for DDoS Botnet Defense in IoT Networks}, 
  year={2026},
  volume={},
  number={},
  pages={1104-1110},
  abstract={As the Internet of Things (IoT) continues to expand across various domains, the number of connected devices is rapidly increasing, exposing IoT environments to large-scale Distributed Denial-of-Service (DDoS) botnet attacks. Due to limited computational and memory resources, IoT devices remain particularly vulnerable to traffic flooding and coordinated malicious behavior. This paper presents a layered security framework that integrates machine learning, protected gateway servers, and blockchain-based smart contracts to detect and mitigate DDoS botnet attacks in IoT environments. The proposed model performs behavioral anomaly detection off-chain using a two-stage machine learning process, while leveraging smart contracts on the blockchain for tamper-resistant logging, automated policy enforcement, and controlled economic penalties. A bounded spending mechanism and quarantine policy are introduced to discourage large-scale malicious traffic while limiting the impact on compromised legitimate devices. The system architecture and enforcement algorithms are presented to demonstrate the feasibility, scalability, and security advantages of the proposed framework.},
  keywords={Payloads;Filtering;Filters;Integrated circuits;Circuits and systems;Botnet;Communication systems;Denial-of-service attack;Distributed denial-of-service attack;Internet;Denial-of-Service (DoS) attack;Internet of Things (IoT);Blockchain;Smart Contracts},
  doi={10.1109/CSNT69054.2026.11502415},
  ISSN={2473-5655},
  month={April},}@INPROCEEDINGS{9221332,
  author={O’Mahony, George D. and Harris, Philip J. and Murphy, Colin C.},
  booktitle={2020 IEEE 6th World Forum on Internet of Things (WF-IoT)}, 
  title={Detecting Interference in Wireless Sensor Network Received Samples: A Machine Learning Approach}, 
  year={2020},
  volume={},
  number={},
  pages={1-6},
  abstract={Wireless Sensor Network (WSN) technology has developed substantially over the past decade or so and now numerous solutions exist across a diverse range of innovative applications. The expanding Internet of Things (IoT) sector is becoming an ever more important aspect of modern technology and a key motivator for improving security and privacy in WSNs. Typically, WSN protocols form an integral part of the overall IoT infrastructure by enabling the sensor to access point communication links. These wireless links inherently encompass security challenges, frequently due to external interference and intrusions. As IoT applications incorporate WSNs in their architecture, the incentive to attack and compromise these WSNs escalates. Often, commercial off the shelf devices and standardized open-access protocols combine to achieve specific WSN deployments. Numerous WSN vulnerabilities exist, whilst attack approaches are abundant and change frequently. Thus, to ensure acceptable performance, safety and privacy in many IoT applications, the adopted WSN must be secure. This paper discusses IoT security and privacy, by evaluating a machine learning approach for interference detection focused entirely on analyzing received In-phase (I) and Quadrature-phase (Q) samples. Significantly, once an intrusion is detected, mitigation strategies can be implemented, thus emphasizing the requirement for interference detection. Random Forest is chosen as the machine learning classifier as it consists of a large number of individual decision trees operating as an ensemble. An intrusion detection system (IDS) is developed based on Matlab simulated ZigBee data as an initial insight into whether a real wireless data approach may be viable.},
  keywords={Wireless communication;Wireless sensor networks;Privacy;Protocols;Zigbee;Interference;Internet of Things;IEEE802.15.4;IoT;Interference;Intrusion;Machine Learning;Random Forest;Security;WSN and ZigBee},
  doi={10.1109/WF-IoT48130.2020.9221332},
  ISSN={},
  month={June},}@ARTICLE{10747334,
  author={Clinton, Urikhimbam Boby and Hoque, Nazrul},
  journal={IEEE Access}, 
  title={MU-IoT: A New IoT Intrusion Dataset for Network and Application Layer Attacks Analysis}, 
  year={2024},
  volume={12},
  number={},
  pages={166068-166092},
  abstract={As the growth of IoT networks increases exponentially, the number of cyber attacks is also increasing on IoT networks day-by-day. This results in the vital requirement of cyber security mechanisms to secure IoT networks from cyberattacks. To build such a security mechanism, researchers and cybersecurity practitioners need relevant IoT datasets. However, until now, only a few publicly available IoT network intrusion datasets exist in the literature. Moreover, these datasets lack coverage of IoT network traffic containing IoT application layer protocols like AMQP, XMPP, STOMP, etc. and various IoT-based attacks. So, in this work, we generate a new realistic and comprehensive IoT network intrusion dataset called MU-IoT for IoT cybersecurity. The network traffic contained in the MU-IoT dataset is collected from the Manipur University (MU) IoT Smart Lab, which is our own IoT network testbed. The testbed includes more than 30 devices, which include both physical and emulated IoT devices, and general-purpose devices such as laptops, desktops, servers, etc., that are usually present in a Smart Lab. The dataset contains normal network traffic generated from various applications and attack network traffic comprised of 16 attack types, including IoT-based attacks, which are categorized into six categories. From the testbed, we collected 22.8 GB of raw network data and extracted 15.8 GB of preprocessed network data by using our own feature extraction approach. The preprocessed network data contains 121 flow-based features and 3 class labels of more than 34.8 million records. Additionally, this dataset covers extensive IoT-specific application protocols and a variety of normal network behaviours, which is a notable advantage over existing datasets. The MU-IoT dataset can be utilized to develop and validate machine learning-based Intrusion Detection and Mitigation Systems (IDMS). Moreover, the MU-IoT dataset helps to validate the centralized and federated learning-based IDMS. In addition, we also include the prior exploratory data analysis with the ranking of the features given by various feature selection algorithms as well as from our own feature ranking approach and the performance given by some common machine learning algorithms, as a future reference to the research community. The MU-IoT dataset is publicly available in the link https://manipuruniv.ac.in/CSDmuIOTdataset/.},
  keywords={Internet of Things;Telecommunication traffic;Feature extraction;Cyberattack;Network intrusion;Protocols;Performance evaluation;Costs;Industrial Internet of Things;Machine learning;Computer security;Internet of Things;IoT dataset;cybersecurity;network testbed;machine learning},
  doi={10.1109/ACCESS.2024.3494052},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{9671613,
  author={Adkisson, Mary and Kimmell, Jeffrey C and Gupta, Maanak and Abdelsalam, Mahmoud},
  booktitle={2021 IEEE International Conference on Big Data (Big Data)}, 
  title={Autoencoder-based Anomaly Detection in Smart Farming Ecosystem}, 
  year={2021},
  volume={},
  number={},
  pages={3390-3399},
  abstract={The inclusion of Internet of Things (IoT) devices is growing rapidly in all application domains. Smart Farming uses IoT devices to increase efficiency and optimize farming operations. These devices can be used in a cloud or edge computing infrastructure which can provide remote control of watering and fertilization, real time monitoring of farm conditions, and provide solutions for more sustainable practices. These improvements to efficiency and ease of use come with added risks to security and privacy. Combining vulnerable IoT devices with the critical infrastructure of the agriculture domain broadens the attack surface for adversaries. Cyberattacks in a large coordinated manner could disrupt the economy of agriculture-dependent nations. To the sensors in a system, an attack may appear as anomalous behaviour. Additionally, there are possibilities of anomalies generated due to faulty hardware, issues in network connectivity (if present), or simply abrupt changes to the environment due to weather, human error, or other unforeseen circumstances. To make these systems more secure, it is imperative to detect such data discrepancies and trigger appropriate mitigation mechanisms. In this paper, we propose an anomaly detection model for Smart Farming using an unsupervised Autoencoder machine learning model. We chose to use an Autoencoder as our method of anomaly detection because it attempts to reconstruct normal data with a low reconstruction loss and anomalous data with a high loss. The high reconstruction loss value for a data point indicates that the data is not like the rest. Our model was trained and tested on data collected from our greenhouse test-bed. Our proposed Autoencoder based anomaly detection method achieved 98.98% and took 262 seconds to train and has a detection time of .0585 seconds.},
  keywords={Privacy;Big Data;Sensor systems;Real-time systems;Sensors;Internet of Things;Security;Smart Farming;Anomaly Detection;Autoencoder;Time-Series Data;Grove Sensors;Unsupervised Learning},
  doi={10.1109/BigData52589.2021.9671613},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{9843007,
  author={Yadav, Nikhil and Truong, Laura and Troja, Erald and Aliasgari, Mehrdad},
  booktitle={2022 IEEE 21st Mediterranean Electrotechnical Conference (MELECON)}, 
  title={Machine Learning Architecture for Signature-based IoT Intrusion Detection in Smart Energy Grids}, 
  year={2022},
  volume={},
  number={},
  pages={671-676},
  abstract={Security vulnerabilities of IoT (Internet of Things) enabled smart grid energy systems is a major concern. Contemporary mitigating frameworks incorporate Network Intrusion Detection Systems (NIDS) and Network Intrusion Prevention Systems (NIPS) whose architecture branches on either signature-based or anomaly-based detection. Signature-based systems offer higher detection rates; however they require tedious manual work to set up signature rules, and are incapable of learning through network traffic - missing out on attacks whose signature is unknown. Alternatively, anomaly-based systems are capable of mitigating the shortcomings of signature-based systems but suffer from high false-positive rates. In this paper, we propose an automated machine learning architecture for IoT-enabled smart energy grids capable of deciding whether to generate rules for signature-based systems. Results are presented using an IoT dataset comprising MITM (man in the middle) attacks, indicating the potential of this framework for intelligent threat mitigation in smart energy infrastructures.},
  keywords={Training;Measurement;Systematics;Supervised learning;Telecommunication traffic;Data aggregation;Generators},
  doi={10.1109/MELECON53508.2022.9843007},
  ISSN={2158-8481},
  month={June},}@INPROCEEDINGS{11506571,
  author={Singh, Samaresh Kumar and Roy, Joyjit and Pushkala, Sriharsha Anand},
  booktitle={2026 39th Conference of Open Innovations Association (FRUCT)}, 
  title={Security Without Detection: Economic Denial as a Primitive for Edge and IoT Defense}, 
  year={2026},
  volume={},
  number={},
  pages={281-289},
  abstract={Sophisticated attackers can evade detection-based security by using encryption, stealth tactics, and low-rate attack patterns. This challenge is particularly acute in Internet of Things (IoT) and edge environments, where limited resources make ML-based intrusion detection systems impractical. Hereby, we present Economic Denial Security (EDS), a framework that renders attacks economically infeasible rather than trying to detect them. EDS exploits a fundamental asymmetry. Defenders control their own environment, whereas attackers do not. The four mechanisms in this framework amplify attack costs superlinearly. These mechanisms include adaptive computational puzzles, decoy-driven interaction entropy, temporal stretching, and bandwidth taxation. This paper uses game theory to mathematically prove the optimal configuration of EDS, and we found that combining multiple safety mechanisms usually costs 2.1 times as much as using them separately, a key trade-off to consider during design. The good news is that EDS is extremely efficient, using less than 12 KB of memory, making it practical to run on small embedded devices like microcontrollers rather than on expensive servers. EDS is tested on 20 different IoT devices under four attack scenarios. The results showed that attacks slow down significantly, costs become asymmetric, attack success rates drop, and the system adds only 20 ms of latency with no false positive results. When tested against real malware (Mirai, Torii, and Hajime), combining EDS with machine learning detection improved protection from 67 % to 88 %. Adding both techniques together reached 94 % protection, a 27 % improvement overall. Unlike traditional detection-based approaches, EDS operates independently, without requiring attack identification, making it practical for resource-limited IoT devices where other methods simply don't work. The system demonstrated enhanced detection and mitigation of malware samples during testing. Notably, EDS conferred significant advantages even in the absence of an intrusion detection system. The implementation of EDS shifts the economic balance in favor of defenders and presents a viable strategy for safeguarding IoT and edge systems.},
  keywords={Costing;Costs;Internet of Things;Timing;Modeling;Security;Signal detection;Printing;IP networks;Machine learning;Economic Denial Security;Intrusion Prevention;Edge Computing;Internet of Things;Cost Asymmetry;Moving Target Defense;Computational Puzzles;Deception;Game Theory},
  doi={10.23919/FRUCT70069.2026.11506571},
  ISSN={2305-7254},
  month={April},}@INPROCEEDINGS{11064106,
  author={Prasanth, A. and Arunkumar, M. S. and Kumaran, B.Senthil and Deepa, S.},
  booktitle={2025 3rd International Conference on Communication, Security, and Artificial Intelligence (ICCSAI)}, 
  title={Design of Smart System for Mitigating Wild Animal Intrusion in Agricultural Farms Using IoT and Deep Learning}, 
  year={2025},
  volume={3},
  number={},
  pages={1-5},
  abstract={The recent development of the Internet of Things (IoT) and Deep Learning models have been enhanced to resolve day-to-day constraints in the agricultural farm. The main constraints are crop damage, human injury, property loss, etc. In the past, traditional methods such as human surveillance, dog bodyguards, and electric fences were utilized to safeguard the agricultural field. However, these methods provide only temporary solutions that fail to save wildlife and humans. Some mitigation techniques are needed to solve these problems. In this work, the wild animal intrusion detection system has been introduced to enhance the safety of wild animals and humans. A novel Adaptive Dot Dis-tance-based YOLOv9 (ADDY) model is employed in the proposed system to detect wild animal intrusions in agricultural farms. In the proposed ADDY model, the Dot Distance (DD) mechanism has been integrated with the YOLOv9 to enhance the decision-making process. The preliminary results show that the proposed ADDY model has a superior accuracy of 98.75% when compared to the existing detection techniques.},
  keywords={Deep learning;Adaptation models;Accuracy;Animals;Surveillance;Wildlife;Intrusion detection;Smart systems;Indexes;Internet of Things;Deep Learning;Smart Agriculture;Animal Intrusion detection;YOLOv9},
  doi={10.1109/ICCSAI64074.2025.11064106},
  ISSN={},
  month={April},}@INPROCEEDINGS{11459590,
  author={D. S., Shivaswamy and B. R., Arun Kumar and B R, Prakash and A, Shreyas},
  booktitle={2025 6th International Conference on Smart Electronics and Communication (ICOSEC)}, 
  title={An Automated VAPT Framework for Smart Home IoT Environments: Protocol-Aware Vulnerability Detection and Mitigation}, 
  year={2025},
  volume={},
  number={},
  pages={1637-1645},
  abstract={The proliferation of Internet of Things (IoT) devices in smart homes has enhanced automation, comfort, and energy efficiency while simultaneously introducing significant security challenges arising from protocol vulnerabilities, weak firmware protections, and fragmented standards. This research presents ProVAPT SmartHome, an automated and protocol-aware Vulnerability Assessment and Penetration Testing (VAPT) framework specifically designed to secure smart home IoT ecosystems. Unlike traditional VAPT tools, ProVAPT combines dynamic protocol analysis, CVE-based vulnerability detection, and lightweight machine learning– driven behavioural anomaly identification within a Windows-based environment suitable for practical deployment in Indian households. The framework was evaluated using commonly available smart home devices such as Wi-Fi and ZigBee enabled smart bulbs, DLink IP cameras, and Xiaomi smart plugs, covering protocols including MQTT, CoAP, UPnP, and ZigBee. ProVAPT identified 17 vulnerabilities comprising 14 known CVEs and 3 previously undocumented zero-day flaws, achieving a true positive rate of 96.1 percent, a false positive rate of 3.8 percent, and an average detection latency of 6.2 seconds per device. Behavioral anomaly detection using an Isolation Forest model reached a precision of 93.7 percent and an F1-score of 93.1 percent, while real-time mitigation was performed through Windows native firewall rules with an 81 percent user confirmation rate. Through its modular architecture, native Windows compatibility, and user-centric mitigation dashboard, ProVAPT SmartHome provides a robust, scalable, and low-overhead solution for IoT threat detection and response, eliminating the need for specialized hardware or Linux systems and establishing a new direction in IoT cybersecurity by integrating protocol awareness, behavioural intelligence, and automated enforcement in a single deployable solution.},
  keywords={Payloads;Military aircraft;Space technology;Feeds;Broadcasting;Broadcast technology;Filtering;Circuits;Central Processing Unit;Feedback;Vulnerability Assessment and Penetration Testing (VAPT);Smart Home Security;Internet of Things (IoT);Protocol Aware Detection;Behavioral Anomaly Detection;MQTT Security;CoAP Vulnerabilities;ZigBee Security;Automated Mitigation;Windows-Based Framework;CVE Exploit Detection;IoT Threat Intelligence},
  doi={10.1109/ICOSEC67334.2025.11459590},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{9697209,
  author={Wankhade, Archana D. and Wagh, Kishor},
  booktitle={2021 International Conference on Computational Intelligence and Computing Applications (ICCICA)}, 
  title={Machine Learning Techniques for defending Cloud enabled IoT network}, 
  year={2021},
  volume={},
  number={},
  pages={1-5},
  abstract={With the expansion of IoT and its network connected devices, security is a major concerns. In IoT networks, the participating nodes are usually resource constrained, due to which they are vulnerable to cyber attacks. Security is the major concerns in the domain of IoT network. As there is a development of IoT network, the security of network layer has a big challenge. So to secure a dynamic IoT network different approaches like deployment of Intrusion Detection and Prevention model can be used to defend against various types of attacks on IoT network. With this Machine Learning can be used to improve the performance of detection and mitigation of attacks.ML which can embed intelligence in the IoT devices and networks, can be used for solving different security problems. The aim is to apply the ML techniques for defending against attacks that cloud enhance the security as well as privacy for IoT systems.},
  keywords={Performance evaluation;Privacy;Intrusion detection;Machine learning;Network security;Logic gates;Security;Machine Learning;Internet of Things (IoT);Intrusion Detection;Intrusion Prevention},
  doi={10.1109/ICCICA52458.2021.9697209},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11403937,
  author={Shammah, Ramisa Samin and Rahman, Ishraf and Guria, Zenith Matin and Kowser, Sultana and Faruq, Omar and Morshed, Niaz},
  booktitle={2025 International Conference on AI-Driven STEM Education and Learning Technologies (AISTEMEDU)}, 
  title={Scalable Machine Learning Architecture for Securing IoT Networks with Digital Governance in the AI Era of Cyber-Resilient Smart Cities}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={With the high rate of Internet of Things (IoT) technologies, a new era of smart cities has been ushered in where the cities have been made more connected, efficient and innovative. However, this development poses great problems in ensuring security and stability of IoT networks. The proposed paper suggests a scalable machine-learning architecture that will enhance the security of IoT networks in smarter cities, and in particular, cyber-resilience in the modern AI age. The proposed architecture merges machine-learned models with digital governance approaches to provide real-time anomaly detection capabilities, intrusion prevention, and privacy-preserving solutions; and outlines the ways AI models can be used in IoT security and discusses the essential concerns, e.g., data privacy, compliance with regulations, and resource utilization. The suggested solution is tested with the help of simulations that prove its efficiency in resisting the process of cyber-attacks and in providing the means of scalability and flexibility in dynamic smart-city settings, which, in its turn, preconditions the establishment of the conceptual background of the formation of cyber-resilient smart cities in which the IoT networks will be able to operate safely and effectively even under the influence of the surfacing cybersecurity threats.},
  keywords={Privacy;Smart cities;Scalability;Prevention and mitigation;Machine learning;Real-time systems;Regulation;Internet of Things;Digital policy;Protection;IoT Networks;Machine Learning;Digital Governance;AI;Cybersecurity;Smart Cities;Cyber-Resilience;Anomaly Detection;Intrusion Prevention;Data Privacy;Scalability;Edge Intelligence;AI-Based Security;Smart City Infrastructure;Machine Learning Architecture},
  doi={10.1109/AISTEMEDU67077.2025.11403937},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10475807,
  author={Catillo, Marta and Pecchia, Antonio and Villano, Umberto},
  booktitle={2023 IEEE International Conference on Cloud Computing Technology and Science (CloudCom)}, 
  title={Traditional vs Federated Learning with Deep Autoencoders: a Study in IoT Intrusion Detection}, 
  year={2023},
  volume={},
  number={},
  pages={208-215},
  abstract={Security of Internet of Things (IoT) devices and networks is a primary concern. Many intrusion detection systems (IDS) proposals in the IoT leverage machine and deep learning algorithms to learn models that can be used to discriminate normal behaviors from intrusions. Due to the dynamicity and scale of modern IoT networks, it is hard to learn and maintain one separate IDS model per device; on the other hand, the Cloud-Edge-IoT architecture allows learning a single IDS model (instead of many separate models). This paper compares two paradigms, i.e., traditional and federated, to learn a single IDS model atop the traffic of different IoT devices. The former assumes the availability of an all-in-one training dataset at a unique learning node; the latter aggregates the outcomes of independent learning procedures executed on individual training datasets hosted by different nodes. The experiments are done with a well-established public benchmark of nine IoT devices and the use of deep autoencoders. In the experiment and dataset at hand, federated learning lead to an increase of the false positive rate of six devices compared to the traditional scenario. Such an increase was balanced by a narrower variability of the false positive rate across all the devices and a mitigation of potential overfitting.},
  keywords={Performance evaluation;Training;Cloud computing;Federated learning;Intrusion detection;Benchmark testing;Internet of Things;intrusion detection;IoT;autoencoder;federated learning},
  doi={10.1109/CloudCom59040.2023.00042},
  ISSN={2380-8004},
  month={Dec},}@INPROCEEDINGS{10908143,
  author={Pham, Van Thinh and Nguyen, Khac Tuan and Nguyen, Chien Trinh and Le, Hai-Chau},
  booktitle={2024 International Conference on Advanced Technologies for Communications (ATC)}, 
  title={GAT-SFFS: A Novel Feature Selection Method Using Graph Attention Networks and Sequential Forward Approach for Machine Learning-Based IoT Intrusion Detection System}, 
  year={2024},
  volume={},
  number={},
  pages={573-578},
  abstract={The rapid expansion of the Internet of Things (IoT) has greatly enhanced convenience and service quality in modern society. However, the proliferation of IoT devices results in massive daily data collection, leading to significant information transmission and privacy challenges. Recognizing the urgent need for effective cyber attack mitigation in IoT networks, we propose a novel feature selection method called GAT-SFFS, which combines the strengths of Graph Attention Networks (GAT) and Sequential Forward Feature Selection (SFFS). This method is designed to extract the optimal feature set (OFS) from the TON-IoT dataset, which is collected from practical IoT environments and used to develop an effective Intrusion Detection System (IDS). The selected OFS is also validated using multiple machine learning classifiers and compared with previous works to assess the efficiency of the proposed method. Our results show that the XGBoost algorithm, utilizing a combination of only 13 features, achieves the highest detection accuracy at 98.91%, surpassing other current approaches. Furthermore, the OFS enhances detection performance and reduces training time. Numerical results demonstrate that the IDS developed with the OFS exhibits exceptional performance, underscoring its potential to address network security challenges in IoT environments effectively.},
  keywords={Training;Machine learning algorithms;Simulation;Prevention and mitigation;Intrusion detection;Quality of service;Network security;Feature extraction;Internet of Things;Standards;Internet of Things;Intrusion Detection System;Graph Attention Network;Machine Learning;Feature Selection},
  doi={10.1109/ATC63255.2024.10908143},
  ISSN={2162-1039},
  month={Oct},}@ARTICLE{11278025,
  author={Shawl, Rashed Qayoom and Singh, Manmeet and Hassan, Malik Mubasher},
  journal={IEEE Communications Standards Magazine}, 
  title={Leveraging Cyber-Physical Security Solutions Blended With Machine Learning for Advanced IoT Botnet Detection}, 
  year={2026},
  volume={10},
  number={3},
  pages={83-93},
  abstract={The proliferation of Internet of Things (IoT) ecosystems has significantly increased the attack surface of cyber-physical systems, leading to the emergence of large-scale botnets that exploit device vulnerabilities for distributed and persistent attacks. This survey comprehensively reviews state-of-the-art techniques that integrate cyber-physical security solutions with machine learning (ML) for advanced detection and mitigation of IoT botnets. It categorizes existing methods into networkcentric, host-based, and hybrid cyber-physical detection frameworks, emphasizing their detection granularity, scalability, and computational feasibility in resource-constrained environments. The paper systematically analyzes supervised, unsupervised, and deep learning approaches, ranging from Random Forests and Support Vector Machines to Autoencoders, LSTMs, and Graph Neural Networks, highlighting their adaptability to evolving botnet behaviours and zero-day threats. Furthermore, the survey explores the integration of federated learning, edge computing, and software-defined networking (SDN) to enable distributed, privacy-preserving, and realtime detection architectures. Key challenges, including data imbalance, adversarial resilience, explainability, and cross-domain generalization, are critically discussed. Finally, this work outlines a taxonomy of cyber-physical and ML-based IoT botnet detection models and identifies future research directions toward autonomous, adaptive, and explainable cyber-physical defense systems.},
  keywords={Internet of Things;Botnet;Security;Adaptation models;Artificial intelligence;Machine learning;Cyber-physical systems;Detection algorithms;Supervised learning;Unsupervised learning;Deep learning},
  doi={10.1109/MCOMSTD.2025.3636269},
  ISSN={2471-2833},
  month={Sep.},}@INPROCEEDINGS{10961773,
  author={Chiona, Ufulu Lawrence and Kumar, Rajendra and Aggarwal, Gunjan},
  booktitle={2024 International Conference on Emerging Technologies and Innovation for Sustainability (EmergIN)}, 
  title={A Comprehensive Survey on Intrusion Detection Systems in IoT Environment}, 
  year={2024},
  volume={},
  number={},
  pages={122-127},
  abstract={This paper provides an in-depth review of Intrusion Detection Systems (IDS) in the context of the Internet of Things (IoT) environment focusing on the rising significance of cybersecurity in interconnected gadgets. With the growth of IoT across industries there are complex security threats to overcome due to the diverse range of devices and their extensive connections leaving these networks susceptible to cyber risks. The paper discusses concepts like active intrusions outlining how IDS functions encompass network-based (NIDS) and host-based (HIDS) systems, as well as employing signature-based detection and behavioral analytics. It also focuses on the advancements in IDS approaches particularly focusing on the shift towards advanced machine learning algorithms that can adapt to the evolving threats within IoT. Furthermore, it explores studies in this field covering strategies from countering Denial of Service attacks to developing intrusion prevention mechanisms. The findings suggest a necessity for creating a stochastic model using machine learning techniques to effectively counter threats and enhance performance.},
  keywords={Surveys;Technological innovation;Intrusion detection;Focusing;Stochastic processes;Standardization;Internet of Things;Computer security;Sustainable development;Testing;IDS;IoT;Cybersecurity;Machine Learning;Threat Intelligence;Active intrusion;Passive intrusion},
  doi={10.1109/EmergIN63207.2024.10961773},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11256432,
  author={Sugirtha, R. and Babu, J. Jagan and Mohankumar, N. and Sreedevi, B. and Chitradevi, B. and Murugan, S},
  booktitle={2025 IEEE International Conference on Contemporary Computing and Communications (InC4)}, 
  title={Reducing Warehouse Inventory Losses with IoT and Support Vector Machines for Shrinkage Control}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Warehouse inventory shrinkage, caused by theft, damage, misplacement, or mistakes, constitutes a substantial challenge in supply chain management, resulting in considerable financial losses. Internet of Things (IoT) technology, including RFID tags, cameras, and environmental sensors, facilitates real-time inventory monitoring. These IoT devices collect data on inventory movement, storage conditions, and possible hazards, allowing enhanced monitoring and insights. Support Vector Machines (SVM), a robust machine learning method, may then analyze this data to discern patterns indicative of possible shrinkage. Training the SVM model on historical data enables the prediction of inventory loss risks and the identification of products with heightened susceptibility. This method enables warehouse managers to use proactive actions to mitigate shrinkage, enhancing inventory accuracy and efficiency. Integrating IoT with SVM improves warehouse operations, resulting in diminished losses, optimized resource allocation, cost efficiency, and more efficient and dependable supply chain. It reduces warehouse inventory loss by 30% with IoT and SVM-based anomaly detection. IoT sensors and RFID tags provide real-time surveillance, improving loss mitigation and inventory accuracy. The system provides unique IoT and SVM integration that outperforms traditional inventory loss prevention methods.},
  keywords={Support vector machines;Industries;Supply chain management;Accuracy;Prevention and mitigation;Predictive models;Real-time systems;Internet of Things;RFID tags;Anomaly detection;Supply Chain Management;Predictive Analytics;Real-time Monitoring;Anomaly Detection;Logistics Optimization},
  doi={10.1109/InC465408.2025.11256432},
  ISSN={},
  month={March},}@ARTICLE{11719618,
  author={Ravindran, Selvam and Sarveshwaran, Velliangiri},
  journal={IEEE Internet of Things Journal}, 
  title={Quantum Kronecker Forward Harmonic Net for Intrusion Detection and Attack Mitigation in IoT-based Smart City Applications}, 
  year={2026},
  volume={},
  number={},
  pages={1-1},
  abstract={In the modern era, people are concerned about protecting their information and ensuring its security. An important method to protect the data through Intrusion Detection systems (IDS), monitoring network activity as well as identifies potential threats during data transmission. Deep Learning (DL) supports the growth of Internet of Things (IoT) and smart cities by enabling devices to analyze data and make particular decisions without relying on human intervention. However, it may lack transparency, making it hard to understand how decisions are made. Therefore, a Quantum Kronecker Forward Harmonic Net (QuKFHNet) framework is developed for intrusion detection in IoT-based smart city applications. First, the system model is performed, and then data is collected from the specified dataset used in this framework. The collected data is normalized by linear normalization technique. Features are selected using Mahalanobis and Chebyshev distance measures. Finally, intrusion detection is performed using the proposed QuKFHNet, which employs quantum-inspired feature transformations implemented on classical computing platforms to enhance complex pattern representation and intrusion classification, followed by attack mitigation. The experimental findings indicate that QuKFHNet attains an accuracy of 96.439 % along with a Negative Predictive Value (NPV) of 94.887 %.},
  keywords={Internet of Things;Intrusion detection;Modeling;Urban areas;Smart cities;Distance measurement;Signal detection;Fluid flow;Security;Telecommunication traffic;Intrusion Detection;Attack Mitigation;Internet of Things;Quanvolutional Neural Network;Deep Kronecker Network},
  doi={10.1109/JIOT.2026.3740021},
  ISSN={2327-4662},
  month={},}@ARTICLE{9240051,
  author={Wan, Tzu-Ling and Ban, Tao and Cheng, Shin-Ming and Lee, Yen-Ting and Sun, Bo and Isawa, Ryoichi and Takahashi, Takeshi and Inoue, Daisuke},
  journal={IEEE Open Journal of the Computer Society}, 
  title={Efficient Detection and Classification of Internet-of-Things Malware Based on Byte Sequences from Executable Files}, 
  year={2020},
  volume={1},
  number={},
  pages={262-275},
  abstract={Simple implementation and autonomous operation features make the Internet-of-Things (IoT) vulnerable to malware attacks. Static analysis of IoT malware executable files is a feasible approach to understanding the behavior of IoT malware for mitigation and prevention. However, current analytic approaches based on opcodes or call graphs typically do not work well with diversity in central processing unit (CPU) architectures and are often resource intensive. In this paper, we propose an efficient method for leveraging machine learning methods to detect and classify IoT malware programs. We show that reliable and efficient detection and classification can be achieved by exploring the essential discriminating information stored in the byte sequences at the entry points of executable programs. We demonstrate the performance of the proposed method using a large-scale dataset consisting of 111K benignware and 111K malware programs from seven CPU architectures. The proposed method achieves near optimal generalization performance for malware detection (99.96% accuracy) and for malware family classification (98.47% accuracy). Moreover, when CPU architecture information is considered in learning, the proposed method combined with support vector machine classifiers can yield even higher generalization performance using fewer bytes from the executable files. The findings in this paper are promising for implementing light-weight malware protection on IoT devices with limited resources.},
  keywords={Malware;Internet of Things;Feature extraction;Computer architecture;Machine learning;Support vector machines;Botnet;Computer security;machine learning;binary code;malware analysis;static analysis},
  doi={10.1109/OJCS.2020.3033974},
  ISSN={2644-1268},
  month={},}@ARTICLE{9870166,
  author={Illy, Poulmanogo and Kaddoum, Georges and de Araujo-Filho, Paulo Freitas and Kaur, Kuljeet and Garg, Sahil},
  journal={IEEE Transactions on Network and Service Management}, 
  title={Retracted: A Hybrid Multistage DNN-Based Collaborative IDPS for High-Risk Smart Factory Networks}, 
  year={2022},
  volume={19},
  number={4},
  pages={4273-4283},
  abstract={New industrial control systems (ICSs) that have been modernized with the industrial Internet of Things (IIoT) are exposed to cyber-attacks that exploit IIoT vulnerabilities. Numerous intrusion detection systems (IDSs) have therefore been proposed to secure ICSs, many of which are based on machine learning, specifically deep neural networks (DNNs). Most of the proposed DNN-based solutions rely on single deep learning models and could be less costly in terms of ICS latency. However, they might have difficulties understanding the increasingly complex data distribution of intrusion patterns. Moreover, single deep learning models may not be effective in capturing the specific patterns of minority classes in highly imbalanced datasets, which is usually the case in cyber-security. Therefore, this paper proposes a novel hybrid multistage DNN-based intrusion detection and prevention system (IDPS) with better accuracy for critical ICSs that cannot afford to compromise on security to improve latency. The proposed approach sequentially learns the decision boundaries of the data that were misclassified or classified with low confidence by previous DNNs. Moreover, it incorporates a collaborative intrusion prevention system (IPS) with an emergency response schema that automatically mitigates attacks as soon as anomalies are detected. The results of experimental evaluations performed on different datasets demonstrate the effectiveness of the proposed solution.},
  keywords={},
  doi={10.1109/TNSM.2022.3202801},
  ISSN={1932-4537},
  month={Dec},}@INPROCEEDINGS{10132152,
  author={Haque, Safwana and El-Moussa, Fadi and Komninos, Nikos and Muttukrishnan, Rajarajan},
  booktitle={2023 IEEE 9th Intl Conference on Big Data Security on Cloud (BigDataSecurity), IEEE Intl Conference on High Performance and Smart Computing, (HPSC) and IEEE Intl Conference on Intelligent Data and Security (IDS)}, 
  title={Identification of Important Features at Different IoT layers for Dynamic Attack Detection}, 
  year={2023},
  volume={},
  number={},
  pages={84-90},
  abstract={With the growth of Internet of Things (IoT), it is essential to devise mitigation techniques to curb related attacks to prevent losses and network disruptions. One popular method of achieving this is with the use of intrusion detection systems (IDSs) that incorporate machine learning (ML) techniques to automatically detect attacks and anomalies. The main purpose of this study was to compare attacks within the same layer (e.g. network layer) or across two different layers (e.g. network and application layers) in order to determine features that are common or unique to each attack and to further determine if attacks belonging to different layers have distinguishing features. To achieve this outcome, the Edge-IIoT dataset was taken into consideration, a recent IoT-related dataset with a varied collection of attack signatures collected using IoT and IIoT (Industrial IoT) sensors. This study mainly focuses on home IoT networks and therefore network traffic flows primarily from five sensors that can be commonly found in a home IoT network were selected from the Edge-IIoT dataset for the ML processes. For the scope of this study, transmission control protocol (TCP) and user datagram protocol (UDP) distributed denial of service (DDoS) attacks were selected as the network layer attacks, while structured query language (SQL) injection and cross-site scripting (XSS) attacks were selected as the application layer attacks. The study identified three features as unique to application layer attacks, four to the XSS attack only, and three to the UDP DDoS attack only. This study also showed that the Edge-IIoT dataset can be reduced to 20 features for optimal ML results (Naïve Bayes [NB] improved to 89.2%, J48 to 94.7% and k-nearest neighbour [k-NN] to 91.7%) using the gain ratio feature selection technique.},
  keywords={Structured Query Language;Protocols;Cross-site scripting;Telecommunication traffic;SQL injection;Feature extraction;Denial-of-service attack;Feature Selection;Internet of Things (IoT);Network Layer Attack;Application Layer Attack;Machine Learning},
  doi={10.1109/BigDataSecurity-HPSC-IDS58521.2023.00025},
  ISSN={},
  month={May},}@INPROCEEDINGS{11379458,
  author={Madhan, S. and BrinthaRajakumari, S.},
  booktitle={2025 2nd International Conference on Artificial Intelligence and Knowledge Discovery in Concurrent Engineering (ICECONF)}, 
  title={Hybrid Intrusion Detection Framework for IoT Applications Enhancing Cybersecurity with AI-Driven Threat Mitigation}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={With the rapid expansion of IoT devices exponentially coming along with cybersecurity risks that keep on changing, new innovative solutions have to be established. The hybrid intrusion detection system, which was proposed by this paper, helps in enhancing security within Internet of Things (IoT). The proposed framework applies both signature-based and anomaly-based approaches to AI -driven threat mitigation and incorporates machine learning in monitoring network traffic, suspicious activities, and the reaction in response to real-time dangers. The system detects known and zero-day threats with low false positive rates by integrating the strengths of conventional detection approaches with powerful artificial intelligence. To protect IoT ecosystems, a reinforcement learning agent optimizes methods in real time to ensure an adaptable and efficient reaction to threats. The framework's scalability, low latency, and excellent detection accuracy across varied IoT installations are shown experimentally using benchmark datasets. A key requirement in today's digital ecosystems is the security of IoT networks against growing cyber-attacks. This hybrid approach offers a robust, adaptive, and efficient solution to this problem.},
  keywords={Accuracy;Prevention and mitigation;Scalability;Ecosystems;Intrusion detection;Telecommunication traffic;Real-time systems;Threat assessment;Internet of Things;Resilience;Internet of Things (IoT);Cybersecurity;Intrusion Detection System (IDS);Hybrid Detection Framework;AI-driven Threat Mitigation},
  doi={10.1109/ICECONF65644.2025.11379458},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11077039,
  author={Sethi, Manoj and Verma, Vishal},
  booktitle={2025 Global Conference in Emerging Technology (GINOTECH)}, 
  title={Protecting Public Safety and Critical Infrastructure Systems in Smart Cities via Cybersecurity: AI- Based Threat Detection and Response}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Smart cities are evolving rapidly (enhanced public safety, improved infrastructure management and optimized urban services) as IoT and automation technologies are embraced in urban spaces worldwide. Yet this very transformation exposes critical infrastructure systems to risks of cyberattacks unprecedented in scale and in nature. That said, safeguarding public safety within smart cities — especially at critical infrastructure sectors such as energy, transportation, health care, and emergency response — requires proactive measures against emerging cyber threats against both physical and digital infrastructures. With this AI-based threat detection and response system, critical infrastructure in smart cities can be developed and secured. This study focuses on extending traditional cybersecurity frameworks with cutting-edge machine learning (ML) and deep learning techniques for immediate anomaly detection, predictive threat modeling, and automated response actions. This enables the system to identify new and advanced attack vectors, such as zero-day exploits, Distributed Denial of Service (DDoS) attacks, and malware intrusions, with greater accuracy and speed than traditional rule-based approaches through the use of AI models across various techniques, including supervised and unsupervised learning methods. The proposed system can operate in various aspects of smart city infrastructure management, such as IoT networks, communication systems, and centralized control. We further explore federated learning's potential to enhance collaborative threat intelligence exchange among critical infrastructure operators while preserving data privacy and security. Moreover, we advocate for resilience via automated response capabilities that reduce the effects of cyberattacks by quickly isolating impacted systems, minimizing damage and enabling rapid recovery. This study illustrates the implementation of AI-driven cybersecurity solutions in the smart city domain insimulation models and case studies related to power grids, smart healthcare systems, and traffic management systems. These findings underscore the effectiveness of leveraging AI-driven methods for detecting sophisticated attack behavior, minimizing false positives, and improving the resilience of critical infrastructure. We also discuss other challenges too— adversarial attacks on AI models, scalability of the system, and ethical concerns regarding usage of data and automation of decision-making based on AI models. These results have important implications at the city-and state-level, as they affirm the need for the adoption of AI-based threat detection and response systems within the cybersecurity frameworks of smart cities to maintain the operational continuity and security of public safety services and other critical infrastructure. The results augment current initiatives seeking to better protect urban environments from the growing onslaught of cyber threats and help enable safer and more sustainable smart cities in the digital era.},
  keywords={Ethics;Smart cities;Transportation;Medical services;Public security;Critical infrastructure;Internet of Things;Computer security;Computer crime;Resilience;Public safety;Critical infrastructure;AI-based threat detection;Internet of Things (IoT);Anomaly detection;Machine learning;Incident response;Distributed systems;Adversarial attacks;Federated learning},
  doi={10.1109/GINOTECH63460.2025.11077039},
  ISSN={},
  month={May},}@INPROCEEDINGS{10048918,
  author={Gaikar, Mrunal Hareshwar and Haribabu, K},
  booktitle={2023 International Conference on Information Networking (ICOIN)}, 
  title={A Data-plane Approach for Detecting Malware in IoT Networks}, 
  year={2023},
  volume={},
  number={},
  pages={578-583},
  abstract={Data plane where all the packet processing and forwarding is done based on control plane logic can be used to monitor the network traffic along with forwarding of the packets. Security threats have become common in IoT networks. Due to the pandemic, as things have moved to virtual platforms, security at every level, including network devices, has become a major concern. Attackers try to gather as much data as possible through various means. In networking, dependence on the control plane to take forwarding decisions is inefficient when quick response is required, in cases of attack mitigation, anomaly detection, intrusion detection etc. Some of the forwarding logic in control plane can be transformed into rules at the data plane. In this work, this is achieved through programmable switches and domain specific language such as P4. A machine learning algorithm is used to train a classifier on publicly available malware dataset. These rules are used for classifying data packets. This work derives rules from a public malware traffic dataset and uses Mininet (network emulator) to emulate an IoT network, and 88% accuracy is achieved in detecting malware at the data plane.},
  keywords={Training;Measurement;Support vector machines;Botnet;Telecommunication traffic;Malware;Classification algorithms;p4;data plane programming;machine learning;malware;malicious},
  doi={10.1109/ICOIN56518.2023.10048918},
  ISSN={1976-7684},
  month={Jan},}@INPROCEEDINGS{11655010,
  author={Raman, Ramakrishnan and Kumar, Rahul and Raj, Benson Edwin},
  booktitle={2026 9th International Conference on Circuit, Power & Computing Technologies (ICCPCT)}, 
  title={IDSIoTAI: An AI-Driven Intrusion Detection Framework for Smart-Home IoT Environments using Naïve Bayes and Support Vector Machine algorithms}, 
  year={2026},
  volume={},
  number={},
  pages={2157-2163},
  abstract={The explosion of Internet of Things (IoT) deployment over the past decade has served as a foundational pillar for global digital transformation. However, the rapid expanding attack surface of IoT architectures often suffers from compromised security paradigms, rendering smart environments highly vulnerable to malicious exploitations. While traditional Intrusion Detection Systems (IDS) mitigate network threats, conventional datasets lack the granular, protocol-specific traffic anomalies characteristic of IoT environments. This research addresses this gap by developing an automated machine learning framework designed to differentiate reconnaissance and anomalous activities from baseline behaviors within smart home IoT infrastructures. Utilizing the Hacking and Countermeasure Research Lab (HCRL) dataset, we evaluate and contrast the efficacy of Naïve Bayes (NB) and Support Vector Machine (SVM) algorithms across varying data-split ratios. Experimental results indicate that while Naïve Bayes offers competitive computational recall in localized environments, the SVM classifier demonstrates superior robustness, achieving an accuracy threshold approaching 99.99% in isolating low-frequency reconnaissance attacks.},
  keywords={Internet of Things;Support vector machines;Modeling;Reconnaissance;Smart homes;Signal detection;Niobium;Intrusion detection;Security;Machining;Artificial Intelligence;Deep learning;Reconnaissance Classification;IoT;Machine learning;Naïve Bayes;Smart Home security;SVM},
  doi={10.1109/ICCPCT70290.2026.11655010},
  ISSN={},
  month={Aug},}@ARTICLE{11460300,
  author={Pustozerova, Anastasia and Gómez, André García and Landauer, Max and Wurzenberger, Markus and Skopik, Florian and Weippl, Edgar and Mayer, Rudolf and Ekelhart, Andreas},
  journal={IEEE Transactions on Reliability}, 
  title={Lightweight Techniques for Federated Anomaly Detection in Log Data}, 
  year={2026},
  volume={75},
  number={},
  pages={1641-1655},
  abstract={Accurately and efficiently identifying anomalies within log data is crucial for maintaining the reliability, availability, and security of modern computing systems. In interconnected environments, log data often come from distributed sources such as Internet of Things devices, industrial networks, or smart grids. Centralizing these logs for anomaly detection can be challenging due to strict confidentiality requirements, regulatory constraints, and the limited bandwidth of edge networks. Federated learning (FL) offers an alternative by enabling local model training on site, while aggregating only models instead of sensitive data, thereby preserving data confidentiality and reducing data transfer. This article develops and evaluates a federated log-anomaly detection pipeline and analyzes its components. We adapt lightweight anomaly detection techniques in a federated setting, comparing them with deep learning (DL) methods, assessing detection capabilities, computational efficiency, memory requirements, and inference time. We explore the residual privacy risks in FL within the proposed pipeline, develop a threat model and suggest mitigation strategies. Our findings indicate that lightweight anomaly detection methods can match the effectiveness of DL techniques in the FL framework, while often providing improved computational and communication efficiency. Furthermore, these techniques show better resilience to non-IID data distributions, a typical FL challenge that can severely hinder the effectiveness of traditional machine learning models. However, the memory footprint of lightweight models varies with dataset characteristics and, in some cases, may exceed that of DL models.},
  keywords={Feeds;Central Processing Unit;Electronic circuits;Internet of Things;Communication systems;Internet;Radio access networks;Regional area networks;Industrial Internet of Things;Protocols;Anomaly detection;federated learning (FL);log data},
  doi={10.1109/TR.2026.3677674},
  ISSN={1558-1721},
  month={},}@INPROCEEDINGS{10039777,
  author={Saurabh, Kumar and Singh, Shubham and Vyas, Ranjana and Vyas, O. P. and Khondoker, Rahamatullah},
  booktitle={2022 IEEE 19th India Council International Conference (INDICON)}, 
  title={MLAPS: A Machine Learning based Second Line of Defense for Attack Prevention in IoT Network}, 
  year={2022},
  volume={},
  number={},
  pages={1-6},
  abstract={Intrusion Prevention Systems (IPSs) are processes that are handled as add-ons to the Intrusion Detection Systems (IDSs) in order to effectively resist and prevent invasions in IoT devices. In this paper, a comparative study on various Machine learning (ML) based Intrusion Prevention System (IPS) has been proposed on UNSW-NB15 dataset by applying various ML methods for classification. For Intrusion Prevention System, two level classifiers for dropping of packets are implemented. Level 1 classifier comprises of Decision Tree (DT) whereas Level 2 classifier uses Random Forest (RF). The proposed IPS automatically adapts to system changes and further reduces training time and increases the accuracy of the system and acts as a lightweight Second Line of Defense System for an IoT Network. In this system, threshold value is calculated by finding the average time of execution of all of the data in the training set.},
  keywords={Training;Computational modeling;Memory management;Intrusion detection;Resists;Real-time systems;Internet of Things;IPS;Intrusion Prevention System;Machine Learning;Intrusion Detection System;IoT;Internet of Thing},
  doi={10.1109/INDICON56171.2022.10039777},
  ISSN={2325-9418},
  month={Nov},}@INPROCEEDINGS{11480603,
  author={Chhetry, Bishal and Dutta, Rajdeep Kumar and Matam, Rakesh and Barbhuiya, Ferdous Ahmed and Sairam, Ashok Singh},
  booktitle={2026 40th International Conference on Information Networking (ICOIN)}, 
  title={A Stage-Wise, XAI-Driven Framework for Mirai Botnet Detection via Multi-Source Data Enrichment}, 
  year={2026},
  volume={},
  number={},
  pages={758-763},
  abstract={The widespread use of the Internet of Things (IoT) ecosystem has introduced new vectors for sophisticated cyberattacks. The Mirai botnet remains one of the most disruptive IoT threats, rapidly propagating across heterogeneous devices and launching high-volume Distributed Denial-of-Service (DDoS) attacks. Existing machine learning (ML) based intrusion detection systems (IDS) rely on public datasets such as IoT-23, CICIoT2023, and MedBIoT, but each captures only partial phases of Mirai's lifecycle (reconnaissance, exploitation, command-andcontrol (C&C) or DDoS). As a result, most detectors are tuned to identify late-stage DDoS traffic while offering limited visibility into early-stage activity, where intervention is most effective. This work constructs an enriched, stage-aligned dataset unifying IoT23, CICIoT2023, and MedBIoT, mapping traffic flows to four Mirai phases: reconnaissance, exploitation, C&C communication, and attack execution. Using this dataset, We develop a stagewise IDS based on Random Forest and XGBoost. Evaluated on a balanced dataset, the framework achieves 92% and 91% accuracy, respectively, across all stages. We further apply SHAP-based explainability to expose feature-level decision rationale for enabling actionable responses at the initial stage of an attack. Our results show that lifecycle-aware, interpretable detection enables proactive Mirai mitigation in real IoT environments.},
  keywords={Central Processing Unit;Memory modules;Electronic circuits;Printed circuits;Botnet;Distributed denial-of-service attack;Internet of Things;Radio frequency;Reconnaissance;Communication systems;Internet of Things;Mirai;Distributed Denial-of-Service;Malware;Botnet Detection},
  doi={10.1109/ICOIN68469.2026.11480603},
  ISSN={2996-1580},
  month={Jan},}@INPROCEEDINGS{11542152,
  author={M.A.Archana and Sugumaran, S. and Parthasarathy, C. and P.Ponsudha and Revathi, G. and M.Thirunavukkarasu},
  booktitle={2026 9th International Conference on Trends in Electronics and Informatics (ICOEI)}, 
  title={An Explainable Hybrid Deep Ensemble Framework for Intrusion Detection in IoT and Enterprise Networks}, 
  year={2026},
  volume={},
  number={},
  pages={1190-1195},
  abstract={Intrusion Detection System (IDS) are very important in protecting the modern IoT and enterprise networks against more complex cyber-attacks. But current machine learning-based and deep learning-based IDS models are usually characterized by a poor temporal modelling ability, an extreme imbalance between classes and no interpretable behaviors, limiting their potential application. In order to overcome these issues, this paper suggests an elucidate hybrid deep ensemble intrusion detection framework to provide an accurate and reliable network traffic analysis. The contributions of this work are as huge as follows: (i) a hybrid intrusion detection model that uses Bidirectional Gated Recurrent Units (Bi-GRU) and Light Gradient Boosting Machine (LightGBM) to jointly learn both the temporal and tabular traffic features; (ii) a class-imbalance mitigation approach based on the adaptive learning adaptations of SMOTE and cost-sensitive learning to improve the performance of minority and rare attacks; (iii) a decision fusion mechanism based on attention that can dynamically provide emphasis on model predictions to enhance resistance to low-frequency attacks and zero-day attacks; (iv) a thorough experimental analysis on CICIDS2017 benchmark data showing higher performance compared to a state of the art intrusion detection models in terms of F1-score, AUC-ROC, and false alarm rates; and (v) a SHAP based explainability module, which gives network administrators transparent and understandable security information. The experiment shows that the framework developed provides a viable, interpretable, and production ready framework of intrusion detection on real time in next generation networked systems.},
  keywords={Modeling;Internet of Things;Intrusion detection;Equations;Deep learning;Learning (artificial intelligence);Printing;Signal detection;Bismuth;Business intelligence;Intrusion Detection System;Cybersecurity;Deep Learning;Ensemble Learning;Bi-GRU;LightGBM;Explainable AI;SHAP;IoT Security},
  doi={10.1109/ICOEI68323.2026.11542152},
  ISSN={},
  month={April},}@INPROCEEDINGS{11548234,
  author={Sharma, Rinku and Sharma, Ashish},
  booktitle={2025 International Conference on Emerging Engineering Technologies and Applications (IC-EETA)}, 
  title={System Level Aspects of the Internet of Things (IoT): An Empirical Investigation}, 
  year={2025},
  volume={},
  number={},
  pages={35-40},
  abstract={The IoT is used as a digital platform to connect various devices in industry, defense medical care, and other organizations. This work gives some important system level characteristics of Internet of things which include scalability, architecture, security, energy efficiency and interoperability. Best practices and challenges for better internet connectivity are considered to analyze real developments. Internet of thing architecture are edge computing and centerline computing. Centralized cloud-based architectures have latency and capacity issues, although they provide strong data analytics. Localised processing offered by edge and fog computing improves system responsiveness and real-time decision-making. Another major concern while IoT networks are spreading rapidly is scalability. This study looks at machine learning-driven resource allocation, network virtualisation, and distributed computing as efficient scalability solutions. Because linked devices have a large attack surface, security is a major concern. In addition to discussing mitigation techniques like blockchain authentication, encryption, and AI-based anomaly detection, this study examines prevalent dangers like data breaches and denial-of-service (DoS) assaults. Inefficiencies result from interoperability problems caused by different hardware and communication protocols. The study emphasises how middleware programs, open standards, and protocol translation help to achieve smooth interoperability.},
  keywords={Ethics;Protocols;Scalability;Computer architecture;Real-time systems;Encryption;Internet of Things;Security;Interoperability;Edge computing;IOT;Network;5G;AI},
  doi={10.1109/IC-EETA66496.2025.11548234},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11390140,
  author={Bhardwaj, Arth and Srivastava, Santosh Kumar and Sagar, Pinki and Mahto, Manoj Kumar},
  booktitle={2025 1st IEEE Uttar Pradesh Section Women in Engineering International Conference on Electrical Electronics and Computer Engineering (UPWIECON)}, 
  title={A Systematic Review of Threat Intelligence and Intrusion Detection Systems in Cybersecurity Architecture}, 
  year={2025},
  volume={},
  number={},
  pages={787-792},
  abstract={With cyber threats becoming more frequent and complex, and as our digital systems grow increasingly connected, Threat Intelligence (TI) and Intrusion Detection Systems (IDS) have taken on a vital role in shaping modern cyber security defenses. This paper offers a systematic review of recent studies, highlighting maj or advancements, integration strategies, and the challenges involved in combining TI and IDS within enterprise, cloud, and Internet of Things (IoT) environments. Using a PRISMA-guided selection and structured data extraction process, the review identifies four dominant research directions: intelligence-driven data fusion, machine learning-assisted detection, adversarial robustness, and automated response orchestration. The analysis indicates that the convergence of TI with AI-powered IDS frameworks substantially strengthens detection precision and situational awareness. However, practical implementations continue to encounter limitations related to data quality, computational scalability, and real-time adaptability. To fill the existing gap in research, this study try to make a common taxonomy that connects Threat Intelligence (TI) data with different Intrusion Detection System (IDS) models. The work also shows some continuous problems like no proper standards for threat data, less privacy when sharing info, and difficulty in making same test results again. The review shows that TI and IDS are slowly moving together towards more smart, explainable and strong systems which will be the main part of the next zero trust cyber security setups.},
  keywords={Taxonomy;Intrusion detection;Computer architecture;Machine learning;Threat assessment;Zero Trust;Internet of Things;Computer crime;Systematic literature review;Resilience;Threat Intelligence (TI);Intrusion Detection System (IDS);Cyber Security Architecture;Machine Learning;Systematic Review;Cloud Security;Internet of Thing (IoT);PRISMA;Zero Trust;Adversarial Resilience},
  doi={10.1109/UPWIECON67212.2025.11390140},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11284011,
  author={Yadav, Isha Ravindra and Wanjale, Kirti},
  booktitle={2025 9th International Conference on Computing, Communication, Control and Automation (ICCCBEA)}, 
  title={Intelligent Cybersecurity for IoT: AI and Big Data in Threat Mitigation}, 
  year={2025},
  volume={},
  number={},
  pages={1-3},
  abstract={The exponential rise in the number of IoT devices has greatly increased the threats that stress cybersecurity, calling for integration of real-time threat intelligence in active measures against cyberattacks. AI and Big Data analytics are contributing to the improvements in IoT security by enabling predictive insights and automated threat mitigation. The article explores the convergence of AI and Big Data in IoT cybersecurity, with special emphasis on machine learning techniques in intrusion detection, real-time analytics in response to threats, and AI automation incorporated in security frameworks. Furthermore, we delve into practical implementations of AI-based cyber threat intelligence, looking into the ways AI models detect anomalies, understand root causes, and prevent malicious access. We also discussed key challenges: data privacy, computational constraints, AI-based security models with a high false-positive rate, and the ethical dilemma. Finally, this paper closes with future research directions in lightweight AI models, scalable security frameworks, and regulatory compliance in AI-IoT cybersecurity.},
  keywords={Data privacy;Automation;Computational modeling;Biological system modeling;Prevention and mitigation;Machine learning;Big Data;Real-time systems;Internet of Things;Computer security;AI;Big Data;Cybersecurity;IoT;Threat Intelligence;Machine Learning;Anomaly Detection;Intrusion Detection;Real-Time Analytics;Automated Response;Data Privacy;Ethical Considerations},
  doi={10.1109/ICCUBEA65967.2025.11284011},
  ISSN={2771-1358},
  month={Aug},}@INPROCEEDINGS{11620816,
  author={Trimbakkar, Aryan and More, Rupali and Thakur, Rajesh and Mohite, Kushal R. and Kharche, Shubhangi and Kerkar, Shravani},
  booktitle={2026 6th International Conference on Intelligent Technologies (CONIT)}, 
  title={GuardianPi: An Edge-Based Explainable Intrusion Detection and Prevention System for IoT Networks Using BiLSTM and DistilBERT}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={The escalating number of Internet of Things (IoT) devices is leading to serious cybersecurity issues because these devices are limited in their computing power and susceptible to different network attacks. Most traditional intrusion detection systems are based on centralized structures and heavy computation models; thus, they cannot be easily used for real-time applications in environments with limited resources. Here we introduce GuardianPi, an IoT security system that is based on the edge and can operate efficiently and in real time. The system uses a Raspberry Pi as a monitoring node at the edge to record network traffic with the help of a lightweight packet inspecting technique. The recorded traffic is converted into flow-based features by CICFlowMeter, which allows for more structured and efficient data representation for machine learning. Our model of Bidirectional Long Short-Term Memory (BiLSTM) is employed to examine the patterns of sequence traffic and to classify network flows accurately as either benign or malicious. A DistilBERT-based module, to make the system more interpretable, gives short and human-readable explanations for the network threats detected. Also, a robotic intrusion prevention method, in real time, updates firewall rules to exclude the malicious sources automatically.Our system achieves a classification accuracy of 99.48%, with its precision, recall, and F1-scores above 0.99 across all attack categories. Our model shows stability in its performance in both training and validation, and hyperparameter tuning shows minimal impact on overall performance metrics. Additionally, the label shuffling validation showed a near-random performance, through which we can infer that the model learns meaningful patterns instead of memorizing the data.},
  keywords={Internet of Things;Modeling;Bidirectional long short term memory;Intrusion detection;Fluid flow;Timing;Printing;Real-time systems;Deep learning;Equations;Intrusion Detection System;IoT Security;Edge Computing;BiLSTM;Explainable AI;DistilBERT;Deep Learning;Network Traffic Analysis;Cybersecurity},
  doi={10.1109/CONIT69683.2026.11620816},
  ISSN={},
  month={June},}@INPROCEEDINGS{11649345,
  author={Zamani, Mazdak},
  booktitle={2026 International Conference on Intelligent and Sustainable AI Systems (ICOSAAS)}, 
  title={Network Access Layer Security in the Age of Artificial Intelligence}, 
  year={2026},
  volume={},
  number={},
  pages={183-189},
  abstract={Artificial Intelligence (AI) is transforming cybersecurity by enhancing both defensive capabilities and offensive cyber operations. While most research focuses on AI-enabled attacks targeting higher layers of the communication stack, less attention has been given to the Network Access Layer, which supports Ethernet, Wi-Fi, MAC addressing, switching infrastructures, and address-resolution protocols. This paper examines how AI amplifies traditional Network Access Layer threats through intelligent reconnaissance, behavioral profiling, device impersonation, protocol exploitation, wireless attacks, radio-frequency intelligence gathering, and large-scale IoT targeting. A taxonomy of AI-driven threats is presented and linked to enabling machine-learning techniques, including reinforcement learning, deep learning, adversarial machine learning, generative AI, federated learning exploitation, and graph analytics. The paper analyzes vulnerabilities affecting hardware, wireless communications, communication protocols, trust models, IoT environments, and AI-based security systems. To address these challenges, a multilayer defense framework is proposed that combines AI-driven intrusion detection, behavioral analytics, explainable AI, Zero Trust principles, secure access-layer controls, and automated response capabilities. The findings demonstrate that AI is fundamentally reshaping the threat landscape at the Network Access Layer and requires adaptive, intelligence-driven security architectures.},
  keywords={Artificial intelligence;Modeling;Machine learning;Internet of Things;Machining;Security;Reconnaissance;Media;Signal detection;Protocols;Artificial Intelligence;Machine Learning;Network Access Layer;MAC Spoofing;ARP Poisoning;Wireless Security;Adversarial Machine Learning},
  doi={10.1109/ICOSAAS68663.2026.11649345},
  ISSN={},
  month={July},}@INBOOK{11455115,
  author={Jandwani, Aman and Arora, Amit K. and Bhanudas, Dadas A. and Singh, Ekta and Madhur and Jandwani, Paras},
  booktitle={Synergies of 6G and IoT}, 
  title={Cybersecurity and Privacy in 6G&#x2010;IoT Ecosystems}, 
  year={2026},
  volume={},
  number={},
  pages={201-229},
  abstract={Summary <p>The combination of sixth&#x2010;generation (6G) wireless communication technology and the Internet of Things (IoT) is transforming the landscape of digital ecosystems across the world by supporting ultrareliable low&#x2010;latency communication (URLLC), massive machine&#x2010;type communications (mMTC), and enhanced mobile broadband (eMBB). Such an evolution enables transformative real&#x2010;time applications in smart cities, industrial automation, healthcare, and immersive virtual environments. However, as the number of autonomously swapping data on billions of interconnected devices reaches astronomical proportions, the cybersecurity and privacy risks skyrocket. The traditional centralized security systems and cryptographic methods like Advanced Encryption Standard (AES) and Rivest&#x2013;Shamir&#x2013;Adleman (RSA) encryption cannot provide the performance, scalability, and resilience demanded by the next&#x2010;generation networks. The evolving and decentralized structure of the 6G&#x2010;IoT requires a new paradigm of cybersecurity infrastructure, utilizing advanced encryption technology, artificial intelligence (AI), and blockchain technologies. This chapter examines the weakness of traditional encryption in ultralow&#x2010;latency settings and reviews ongoing cryptographic developments such as post&#x2010;quantum cryptography (PQC), lightweight cryptographic algorithms, homomorphic encryption (HE), and secure multicomputation (SMPC). It discusses how blockchain helps improve data integrity, device authentication, and decentralized access control in distributed networks. The conversation extends to AI&#x2010;driven threat detection frameworks, deep learning (DL), reinforcement learning (RL), federated learning (FL), and collaborative intrusion detection systems (IDS), security analytics that are adaptable, scalable, and privacy&#x2010;preserving. Focused on the proliferation of cyber&#x2010;physical systems, this chapter strives to achieve a coherent security strategy that ensures confidentiality, real&#x2010;time threat intelligence, and dispersed trust. By analyzing such technologies as blockchain&#x2010;mediated federated AI training, smart contract&#x2010;based access control, and pipelines of secure communication enhanced with encryption, it proposes an integration&#x2010;risk&#x2010;mitigation&#x2010;agile&#x2010;security&#x2010;framework fit for critical 6G&#x2010;IoT applications. The chapter continues to contextualize the role of compliance mechanisms such as the General Data Protection Regulation (GDPR) and the California Consumer Privacy Act (CCPA). It emphasizes the necessity of building systems in line with global privacy standards.</p>},
  keywords={6G mobile communication;Encryption;Cryptography;Security;Internet of Things;Privacy;Protocols;Computer security;Ecosystems;Real-time systems},
  doi={10.1002/9781394370702.ch10},
  ISSN={},
  publisher={IEEE},
  isbn={9781394370696},
  url={https://ieeexplore.ieee.org/document/11455115},}@INPROCEEDINGS{11693831,
  author={Khan, Adil and Eleyan, Amna and Bejaoui, Tarek},
  booktitle={2026 International Symposium on Networks, Computers and Communications (ISNCC)}, 
  title={A Lightweight Bounded-Residual DAE for Mitigating Adaptive Attacks on IoT Intrusion Detection Systems}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={Machine-learning intrusion detection has strengthened protection in Internet of Things (IoT) networks, but it also creates a new attack surface: small, deliberately chosen changes to flow features can make malicious traffic appear benign. Classifier hardening retrains the detector, while existing non-invasive schemes can add auxiliary detection, multiple reconstructors or iterative inference. We present a lightweight bounded-residual denoising autoencoder (DAE) that operates as an input purifier before a frozen feed-forward neural network. The 220-parameter DAE learns to preserve clean benign and malicious records while reconstructing adversarial records towards their clean counterparts; a validation-selected residual strength prevents excessive correction of unperturbed traffic. The pipeline is evaluated across three seeds on BoT-IoT and CICIDS2017 under adaptive white-box FGSM and multi-restart PGD, with PGD adversarial training included as a classifier-modifying comparator. On sealed BoT-IoT test data, the DAE reduced FGSM and PGD attack success rates on a fixed malicious cohort by 36.45% and 32.20%, while clean accuracy changed from 90.75% to 89.72%. On CICIDS2017, reductions were 25.01% and 5.72%, with accuracy changing from 83.28% to 82.91%. The findings support the compact pre-filter as a partial mitigation when retraining is not practical, but not as a universal defence.},
  keywords={Internet of Things;Modeling;Cleaning;Training;Recording;Seeds (agriculture);Bot (Internet);Chatbots;Printing;Accuracy;adversarial machine learning;denoising autoencoder;intrusion detection system;Internet of Things;input purification},
  doi={10.1109/ISNCC70543.2026.11693831},
  ISSN={2768-0940},
  month={Sep.},}@INBOOK{10554510,
  author={Nair, Meghna Manoj and Deshmukh, Atharva and Tyagi, Amit Kumar},
  booktitle={Automated Secure Computing for Next-Generation Systems}, 
  title={Artificial Intelligence for Cyber Security}, 
  year={2024},
  volume={},
  number={},
  pages={83-114},
  abstract={Summary <p>Artificial intelligence (AI) has helped industries and society today to become modern and more productive. Using the Internet of Things (IoT), we can sense and transfer data through the Internet from one device to another and can perform/do tasks efficiently AI use today has been increased from one application to many, i.e., from the agriculture sector to weather prediction. In agriculture, the quality of soil and crop growing or crop cutting, etc., work can be performed with the help of AI; similarly in weather prediction, the situation of upcoming days can be identified, and AI can help in reducing causalities. Note that AI is more useful with IoT/smart devices. Around the world, when these sectors use IoT in their work, several cyber&#x2010;attacks or vulnerabilities are mitigated. which addresses the need to prevent, detect, and recover from any failure of systems. Such attacks need to be detected so quickly, but human/skilled professionals take a lot of time to trace and track or recover from such cyber&#x2010;attacks. Thus, in the near future, we predict what will happen when AI will help professionals to trace and track cyber&#x2010;attacks and avoid many huge losses. Identifying spam mail, junk mails, etc., is an example of machine learning. Hence, cyber security is the need of the hour because it is the need of every industry/business, especially critical businesses or sectors like healthcare. We are looking forward to providing innovative solutions to avoid such attacks or vulnerabilities by mitigation on a public network/infrastructure using artificial intelligence. We discuss about AI and its importance in intrusion detection/vulnerability detection (benefits, pitfalls, future uses), etc.</p>},
  keywords={Security;Artificial intelligence;Computer crime;Computer security;Cyberattack;Organizations;Information security},
  doi={10.1002/9781394213948.ch5},
  ISSN={},
  publisher={Wiley},
  isbn={9781394213931},
  url={https://ieeexplore.ieee.org/document/10554510},}@INPROCEEDINGS{10882542,
  author={Saxena, Akshat and Vijayashree, J. and Jayashree, J. and Jha, Vaibhavi and Kakrani, Sidharth},
  booktitle={2024 13th International Conference on System Modeling & Advancement in Research Trends (SMART)}, 
  title={Securing the Threads: In-Depth Analysis of IoT Architecture and Threat Mitigation}, 
  year={2024},
  volume={},
  number={},
  pages={160-165},
  abstract={The rapid proliferation of the Internet of Things is changing industries by making connectivity seamless in nearly every object and letting them exchange data. The major problem inherent to the complexity and decentralization of IoT architectures is security, thereby making them vulnerable to a wide arrayof threats. This paper discusses in detail the architecture of IoT, the vulnerabilities at each layer, starting from device hardware and moving on to communication protocols and cloud services. We probed into a very wide and increasing threat landscape that includes a number of attacks such as Distributed Denial of Service, man-in-the-middle, and firmware tampering that have been exploiting these vulnerabilities. In the paper, we discussthe current security measures against these threats and also propose a holistic framework of threat mitigation by incorporating advanced encryption techniques, machine learning-based anomaly detection, and blockchain for secure data transactions. The paper, by hitting at the very security issues within the lo$T$, aims at contributing to the development of more resilient and trustworthy IoT systems that ensure safe and efficient operation in critical sectors.},
  keywords={Industries;Technological innovation;Protocols;Prevention and mitigation;Complexity theory;Blockchains;Security;Stakeholders;Reliability;Microprogramming;Internet of Things;network security;privacy;smart home network},
  doi={10.1109/SMART63812.2024.10882542},
  ISSN={2767-7362},
  month={Dec},}@ARTICLE{10970110,
  author={Islam, Anik and Karimipour, Hadis and Reddy Gadekallu, Thippa},
  journal={IEEE Internet of Things Journal}, 
  title={An Explainable AutoML-Driven Meta-Learning Scheme for Intrusion Prevention in Zero-Touch Networks Within Carbon Intelligent IIoT}, 
  year={2025},
  volume={12},
  number={17},
  pages={34731-34742},
  abstract={Carbon intelligent Industrial Internet of Things (IIoT) systems are critical for achieving sustainable industrial automation but face challenges, such as scalability, operational complexity, and security vulnerabilities. Zero-touch networks (ZTN), with their autonomous management capabilities, offer solutions to operational challenges but remain vulnerable to sophisticated cyber intrusions due to their high level of autonomy and interconnectedness. While artificial intelligence (AI), especially deep learning (DL), shows potential in intrusion detection, current approaches often encounter obstacles, such as insufficient datasets, challenges in automated data preprocessing, and a lack of transparency. This article introduces an AutoML-enabled Meta Learning-based Intrusion Prevention Scheme designed specifically for ZTN within carbon intelligent IIoT. The proposed framework integrates AutoML and meta-learning to streamline data preprocessing and improve model adaptability in dynamic and evolving threat environments. To ensure transparency, an integrated gradient-based explainable AI (XAI) mechanism is employed, offering insights into the impact of individual features on model predictions, thereby addressing concerns related to trust and accountability in industrial applications. Experimental evaluations demonstrate the framework’s effectiveness in enhancing intrusion prevention, bolstering security, and improving transparency for ZTN in carbon intelligent IIoT, providing a comprehensive solution to prevailing challenges.},
  keywords={Industrial Internet of Things;Artificial intelligence;Metalearning;Automated machine learning;Prevention and mitigation;Data preprocessing;Carbon;Explainable AI;Adaptation models;Optimization;AutoML;carbon intelligent Industrial Internet of Things (IIoT);deep learning (DL);explainable AI (XAI);machine learning (ML);meta-learning;zero-touch network},
  doi={10.1109/JIOT.2025.3562165},
  ISSN={2327-4662},
  month={Sep.},}@ARTICLE{9941074,
  author={Jayalaxmi, P. L. S. and Saha, Rahul and Kumar, Gulshan and Conti, Mauro and Kim, Tai-Hoon},
  journal={IEEE Access}, 
  title={Machine and Deep Learning Solutions for Intrusion Detection and Prevention in IoTs: A Survey}, 
  year={2022},
  volume={10},
  number={},
  pages={121173-121192},
  abstract={The increasing number of connected devices in the era of Internet of Thing (IoT) has also increased the number intrusions. Intrusion Detection System (IDS) is a secondary intelligent system to monitor, detect, and alert about malicious activities; an Intrusion Prevention System (IPS) is an extension of a detection system that triggers relevant action when an attack is suspected in a futuristic aspect. Both IDS and IPS systems are significant and useful for developing a security model. Several studies exist to review the detection and prevention models; however, the coherence in the opportunistic or advancements in the models is missing. Besides, the existing models also have some limitations, which need to be surveyed to develop new security models. Our survey is the first one to present a study of risk factor analysis using mapping technique, and provide a proposal for hybrid framework for an efficient security model for intrusion detection and/or prevention. We explore the importance of various Artificial Intelligence (AI)-based techniques, tools, and methods used for the detection and/or prevention systems in IoTs. More specifically, we emphasize on Machine Learning (ML) and Deep Learning (DL) techniques for intrusion detection-prevention systems and provide a comparative analysis focusing on the feasibility, compatibility, challenges, and real-time issues. This present survey is beneficial for industry and academia to categorize the challenges and issues in the current security models and generate the new dimensions of developments of security frameworks with efficient ML or DL methods.},
  keywords={Internet of Things;Security;IP networks;Intrusion detection;Firewalls (computing);Monitoring;Encryption;Machine learning;Intrusion detection;intrusion prevention;internet of thing;machine learning;deep learning artificial intelligence},
  doi={10.1109/ACCESS.2022.3220622},
  ISSN={2169-3536},
  month={},}@ARTICLE{11173243,
  author={Hafsa, Noor and Alzoubi, Hadeel and Imran, Sajida},
  journal={Journal of Communications and Networks}, 
  title={Machine learning-based intrusion detection and prevention using cross-layer features in Internet of Things (IoT) networks}, 
  year={2025},
  volume={27},
  number={5},
  pages={345-358},
  abstract={The IoT has emerged as a significant target for cyber-attacks, particularly with a focus on the routing protocol for low-power and lossy networks (RPL) within Wireless Sensor Networks (WSNs). These attacks can disrupt network topologies and compromise data transmission. Early detection of routing attacks is crucial, particularly in resource-constrained RPL networks. This study employed a simulated dataset encompassing Hello Flood, Version Number, and Worst Parent attacks to develop a robust detection model for resource-based routing attacks in IoT networks. In this research, a novel cross-layer feature analysis was conducted, identifying 12 key features crucial for distinguishing between normal and malicious nodes within the network out of the 29 features examined. Various machine learning algorithms, including random forest, CatBoost, and extreme gradient boosting, were evaluated for precise classification. The optimized CatBoost model, a gradient-boosting decision tree (DT) algorithm, demonstrated outstanding performance with a 99% of detection rate, 0.8% of false positive rate, 98% of sensitivity, and 98% of positive predictive values on an independent test dataset. Furthermore, an advanced intrusion prevention algorithm leveraging cross-layer feature-induced intrusion detection was introduced to effectively combat prevalent routing attacks. This study significantly contributes to enhancing cybersecurity in IoT networks, particularly in smart cities, by offering robust intrusion detection and prevention mechanisms.},
  keywords={Internet of Things;Security;Routing;Routing protocols;Intrusion detection;Prevention and mitigation;Feature extraction;Cross layer design;Topology;Reliability;Cross-layer;cyber attacks;intrusion detection;intrusion prevention;IoT;machine learning;RPL},
  doi={10.23919/JCN.2025.000053},
  ISSN={1976-5541},
  month={Oct},}@INPROCEEDINGS{10391727,
  author={Krishna Vanakamamidi, Rama and Ramalingam, L. and Abirami, N. and Priyanka, S. and Kumar, C. Sasi and Murugan, S.},
  booktitle={2023 Second International Conference On Smart Technologies For Smart Nation (SmartTechCon)}, 
  title={IoT Security Based on Machine Learning}, 
  year={2023},
  volume={},
  number={},
  pages={683-687},
  abstract={The protection of user privacy and mitigation of threats like spoofing, DoS, jamming, and eavesdropping are essential for the Internets of Things (IoT) to fulfill its promise of bringing improved and intelligent services to users via the integration of diverse devices into networks. Machine learning (ML) approaches, including supervised learning, unsupervised learning, and Reinforcement Learning (RL), are explored as potential solutions for securing the IoT. This article focuses on the use of ML in IoT authentications, access controls, secured offloading, and malware detection strategies to safeguard sensitive information. The challenges of incorporating these ML-based security strategies into real-world IoT systems are also discussed. A complete analysis of the threats facing IoT networks is provided, as the methods already in use to protect against them and the need for securing such networks. Then, highlight the areas where these security solutions are lacking and might benefit from ML and DL methods. Finally, go through in-depth the current ML and DL methods for dealing with various IoT network security issues. Several potential research possibilities for IoT securities based on ML and DL are also discussed.},
  keywords={Access control;Costs;Supervised learning;Training data;Authentication;Feature extraction;Internet of Things;IoT;ML;Privacy;Security;Deep Learning;Reinforcement learning},
  doi={10.1109/SmartTechCon57526.2023.10391727},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11503950,
  author={Siam, Abdullah Al and Shohan, Sadequzzaman and Faruqui, Nuruzzaman and Alazab, Moutaz},
  booktitle={2025 IEEE International Conference on Signal Processing, Information, Communication and Systems (SPICSCON)}, 
  title={Explainable Intrusion Detection and Prevention Framework for Next-Generation Networks}, 
  year={2025},
  volume={},
  number={},
  pages={105-109},
  abstract={The introduction of next-generation networks, including $5 \mathrm{G} / 6 \mathrm{G}$, software-defined networking (SDN), and largescale Internet of Things (IoT) deployments, generates huge traffic volumes and dynamic threat surfaces, both of which pose significant challenges to traditional intrusion detection and prevention systems. Machine learning has increased detection accuracy, but most models are opaque, undermining analyst trust and making them challenging to implement in mission-critical settings. This paper proposes a practical intrusion detection and prevention model that combines gradient-boosted decision trees with SHAP explanations and lightweight transformer models, featuring attention-based explainability. Identified intrusions are overlaid on SDN-based mitigation measures, such as flow blocking, rerouting, and rate limiting. A confidence threshold is used to escalate to human analysts when explanations are unclear. Experiments conducted independently on the CICIDS2017 and UNSW-NB15 datasets, along with an emulated SDN testbed that the proposed framework achieves an accuracy of above 94% and generates explanations within less than 5 ms. The detection-toprevention latency of the proposed framework decreases from 12.4 ms to 8.7 ms compared to a baseline IPS. These findings indicate that explainable, real-time IDS/IPS systems can be both highly accurate and transparent, and efficient in prevention, thereby improving trust and accountability in next-generation network defense.},
  keywords={Software defined networking;Modeling;Next generation networking;Printing;Intrusion detection;Fluid flow;Internet of Things;Signal detection;Accuracy;Explainable AI;Explainable Artificial Intelligence (XAI);Intrusion Detection System (IDS);Intrusion Prevention System (IPS);Software-Defined Networking (SDN);5G/6G Networks;Gradient Boosted Decision Trees (GBDT);Transformer Models;Network Security},
  doi={10.1109/SPICSCON69221.2025.11503950},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11604684,
  author={G, Vijayaraj and S, Bose and T, Shruthi and S, Vijayalakshmi and D, Prabhu and N, Maheswaran},
  booktitle={2026 Third International Conference on Innovations in Cybersecurity and Data Science (ICICDS)}, 
  title={Adaptive Explainable AI for Cybersecurity in IoT Based Smart Transportation Using Deep Learning}, 
  year={2026},
  volume={},
  number={},
  pages={566-573},
  abstract={The integration of IoT into smart transportation systems has improved traffic management and vehicle safety while increasing vulnerability to cybersecurity threats. Conventional IDS architectures are largely dependent on rule-based detection strategies, making them less effective in identifying advanced, adaptive, and previously unknown cyberattacks. This research proposes an Adaptive Explainable AI (XAI) framework for cybersecurity in IoT-based smart transportation using deep learning techniques. The framework integrates Binary CNN, Multiclass CNN, and LSTM-GRU models for accurate intrusion detection and attack classification. To enhance transparency and interpretability, SHAP and attention mechanisms are incorporated to explain model predictions and identify influential network traffic features. An Intrusion Prevention System (IPS) is also integrated for real-time threat mitigation and malicious IP blocking. Experimental evaluation using the CIC-ToN-IoT dataset shows that the proposed system achieved an accuracy of 97.48%, demonstrating effective detection of multiple cyberattack types while providing a scalable, interpretable, and efficient cybersecurity solution for smart transportation environments.},
  keywords={Internet of Things;Modeling;Convolutional neural networks;Intrusion detection;Computer security;Equations;Printing;Deep learning;Timing;Real-time systems;Internet of Things (IoT);Smart Transportation Systems;Cybersecurity;Intrusion Detection System (IDS);Intrusion Prevention System (IPS);Explainable Artificial Intelligence (XAI);Deep Learning;Binary Convolutional Neural Network (Binary CNN);Multiclass CNN;LSTM-GRU Model;SHAP;Network Traffic Analysis;CIC-ToN-IoT Dataset;Real-Time Threat Detection;IoT Network Security},
  doi={10.1109/ICICDS70526.2026.11604684},
  ISSN={},
  month={June},}@ARTICLE{11359684,
  author={Jamshidi, Saeid and Wahab, Omar Abdul and Herrero, Rolando and Khomh, Foutse and Bellaïche, Martine and Keivanpour, Samira and Shahabi, Negar and Nikanjam, Amin and Nafi, Kawser Wazed},
  journal={IEEE Internet of Things Journal}, 
  title={Think Fast: Real-Time IoT Intrusion Reasoning Using IDS and LLMs at the Edge Gateway}, 
  year={2026},
  volume={13},
  number={8},
  pages={15485-15513},
  abstract={As the number of connected Internet of Things (IoT) devices continues to grow, securing these systems against cyber threats remains a pressing challenge, especially within environments constrained by limited computational and energy resources. This article presents an edge-centric intrusion detection system (IDS) framework that seamlessly integrates lightweight machine learning (ML)-based IDS models with pretrained large language models (LLMs) to enhance detection accuracy, semantic interpretability, and operational efficiency at the network edge. The system evaluates six ML-based IDS models: decision tree (DT),  $K$ -nearest neighbor (KNN), random forest (RF), convolutional neural network (CNN), long short-term memory (LSTM), and a hybrid model of CNN and LSTM, on low-power edge gateways, achieving accuracy up to 98% under real-world cyberattacks. Furthermore, for anomaly detection, the system transmits a compact, secure telemetry snapshot (e.g., CPU usage, memory usage, latency, and energy consumption) via low-bandwidth application programming interface (API) calls to LLMs, including GPT-4-turbo, DeepSeek V2, and LLaMA 3.5. These models employ zero-shot, few-shot, and chain-of-thought (CoT) reasoning to deliver human-readable threat analyses and actionable mitigation recommendations. Extensive evaluations across diverse attacks such as denial of service (DoS), distributed denial of service (DDoS), brute force, and port scanning, demonstrate the system’s ability to enhance interpretability while maintaining low latency (<1.5 s), minimal bandwidth usage (<1.2 kB per prompt), and energy efficiency (<75 J), establishing it as a practical and scalable IDS solution for the edge gateway.},
  keywords={Cognition;Image edge detection;Logic gates;Long short term memory;Semantics;Internet of Things;Computational modeling;Convolutional neural networks;Security;Energy consumption;Cybersecurity;denial-of-service (DoS) attacks;intrusion detection;machine learning (ML)},
  doi={10.1109/JIOT.2026.3656738},
  ISSN={2327-4662},
  month={April},}@INPROCEEDINGS{11621770,
  author={Abhishek, Anala Venkata Sai and Hegde, Praveen},
  booktitle={2026 6th International Conference on Intelligent Technologies (CONIT)}, 
  title={Resilient Network Security Models for Dynamic Threat Landscapes}, 
  year={2026},
  volume={},
  number={},
  pages={1-10},
  abstract={The cyber world has experienced a rapid evolution of threats, and the distributed nature of digital infrastructures is becoming increasingly complex, posing challenges to traditional network security approaches. Today's enterprises, cloud deployments, Internet of Things (IoT) systems, and edge computing applications demand intelligent and adaptive security solutions that can detect, mitigate, and recover from advanced attacks in real time. The study suggests a resilient network security model that leverages artificial intelligence, machine learning, behavioral analytics, and automation for responding to evolving threats. The design includes multi-layer security architecture, anomaly-detection based intrusion detection, adaptive access control and predictive threat intelligence to increase the network's resilience and reduce security vulnerabilities. In addition, the model is able to detect ransomware, DDoS, phishing, insider threats and zero-day attacks as they happen, because of its real-time traffic monitoring and distributed threat analysis. Experimental testing shows better threat detection accuracy, response time, network reliability and efficiency in attack mitigation than traditional security methods. The proposed system also highlights that it is scalable, interoperable, and secure for data communication in a heterogeneous network environment. The findings suggest that resilient and adaptive security architectures can play a critical role in enhancing cyber security in large-scale, very dynamic and complex network ecosystems.},
  keywords={Modeling;Internet of Things;Machine learning;Security;Computer security;Machining;Equations;Timing;Anomaly detection;Artificial intelligence;Network Security;Cybersecurity;Dynamic Threat Landscapes;Intrusion Detection System (IDS);Artificial Intelligence;Machine Learning;Threat Intelligence;Anomaly Detection;Adaptive Security Framework;Distributed Denial-of-Service (DDoS);Zero-Day Attacks;Network Resilience;Secure Communication;Behavioral Analytics;Automated Incident Response},
  doi={10.1109/CONIT69683.2026.11621770},
  ISSN={},
  month={June},}@INPROCEEDINGS{10547904,
  author={Biswas, Rahul and Samanta, Pravin Kumar and Prasad de, Bishnu and Bakshi, Amit and Bhowmik, Wriddhi and Panda, Niten Kumar},
  booktitle={2024 International Conference on Recent Advances in Electrical, Electronics, Ubiquitous Communication, and Computational Intelligence (RAEEUCCI)}, 
  title={IoT based Real Time Anomaly Detection in Automotive ECUs Using Machine Learning}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Electronic control units (ECU s) play a vital role in modern vehicles, but their increased use opens vehicles to cyber-attacks that threaten safety and privacy. This research proposes a novel approach for real-time detection and mitigation of ECU attacks, leveraging machine learning (ML) and IoT communication protocols. The methodology involves these key stages: data collection, data preprocessing, anomaly detection, and IoT -enabled alerting. Simulation of a Controller Area Network (CAN) facilitates the capture of ECU communication packets. Data preprocessing involves normalization, calculation of message reception intervals, and extraction of salient features. This work focuses on slope analysis for anomaly detection. A significant deviation in slope from a baseline pattern could indicate a potential attack. Upon detection, an alert is generated and transmitted through IoT protocols (e.g., MQTT), facilitating real-time notification. A proof-of-concept demonstrates the solution's effectiveness in detecting real-world attack scenarios, including introducing a malicious ECU to disrupt communication. Combining ML and IoT integration, this approach achieves accurate detection. This work advances automotive cyber-security by providing a real-time, reliable ECU attack detection and alerting solution, promoting safer driving experiences.},
  keywords={Privacy;Protocols;Data preprocessing;Machine learning;Feature extraction;Real-time systems;Safety;ECU Attack Detection;Machine Learning;Anomaly Detection;Data Analysis;IoT},
  doi={10.1109/RAEEUCCI61380.2024.10547904},
  ISSN={},
  month={April},}@INPROCEEDINGS{11608173,
  author={Al-Naimi, Taha Mahmoud and Khalid, Hasnaa F and Khalaf, Amna Khaled and Mohammed, Avan Majid and Abdulhussein, Sabah F. and Alwitry, Safa Khalid and Jasim, Qutaiba Nazar and Ahmed, Shouket A. and Radhi, Ahmed Dheyaa},
  booktitle={2026 2nd International Symposium on AI-Driven Engineering Systems (ISADES)}, 
  title={A Cybersecurity Framework for Smart Grid Renewable Energy Systems: Detection, Analysis, and Mitigation}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={The high rate of incorporation of renewable energy sources into smart grid systems has brought about sensitive cybersecurity weaknesses that jeopardize the stability, reliability, and security of contemporary power systems. Smart grids are being targeted by advanced cyberattacks such as denial-of-service (DoS), man-in-themiddle (MITM), false data injection (FDI), reconnaissance, and replay attacks as they become increasingly reliant on networks of interconnected communication, supervisory control and data acquisition (SCADA) systems, and Internet of Things (IoT) devices. This paper is a detailed cybersecurity architecture of the smart grid renewable energy systems that incorporates sophisticated detection, analysis, and automated mitigation. The suggested framework incorporates an autoencoder-based anomaly detection algorithm with an ensemble machine learning classifier based on a weighted fusion strategy that incorporates the use of both algorithms (Random Forest and Gradient Boosting). New adaptive hybrid information gain and autoencoder-based feature selection algorithms are proposed to maximize the input feature space thus enhancing the detection accuracy but minimizing the computational cost. The framework has an overall detection accuracy of 98.4 and precision, recall and F1score exceeding 97 percent among all types of attacks. The experimental testing shows that the suggested method is superior to state-of-the-art methods. Moreover, the framework has the built-in real-time automated mitigation module, which can respond to identified threats within The time required ranges from 25 milliseconds (low-load conditions) to 125 milliseconds (peak DDoS storm conditions), with a median time of about 48 milliseconds across all test conditions.},
  keywords={Smart grids;Signal detection;Modeling;Timing;Computer security;Internet of Things;Machine learning;Renewable energy sources;Accuracy;Aluminum;Cybersecurity;Smart Grid;Renewable Energy;Intrusion Detection;Machine Learning},
  doi={10.1109/ISADES69945.2026.11608173},
  ISSN={},
  month={June},}@INPROCEEDINGS{11468748,
  author={Shukla, Himanshu and Pratap, Ajay and Dev, Harsh},
  booktitle={2026 International Conference on Computing, Sciences and Communications (ICCSC)}, 
  title={Real-Time SDN-Assisted Adaptive Defense Against IoT Botnets Using Hybrid Deep Learning Models}, 
  year={2026},
  volume={},
  number={},
  pages={1-5},
  abstract={IoT concepts are implemented in various domains, and it has increased exposure towards security threats such as botnet attacks. During the botnet attacks compromised nodes are exploited to launch DDoS attacks. Several conventional intrusion detection mechanisms are already existing but are ineffective against such evolving threats. This research paper has proposed a detection framework based on hybrid deep learning which integrates the concept of Convolutional Neural Networks (CNNs) and Recurrent Neural Networks (RNNs). These techniques will be used to capture both spatial patterns and temporal dependencies in network traffic. We have also proposed a federated learning strategy to ensure data privacy during training. This research also incorporates mitigation mechanism based on Software-Defined Networking (SDN) for timely threat containment. This technology is very useful as it enables rapid identification and isolation of malicious traffic flows. Certain lightweight optimization techniques that include model pruning and quantization are used in this research paper to reduce complexity without sacrificing performance. Experimental validation has been conducted on the UNSW-NB15 dataset that demonstrates a high detection accuracy of 99.1% which is much better as compared to existing conventional techniques. The results confirm that the integration of hybrid deep learning models with SDN-based control offers a robust and scalable solution for real-time IoT botnet defence.},
  keywords={Botnet;Communication systems;Internet;Internet of Things;Software defined networking;Telecommunication traffic;Denial-of-service attack;Protocols;Computer networks;Cloud computing;Hybrid Deep Learning;IoT Botnet Security;Real-Time Attack Mitigation;Software-Defined Networking (SDN)},
  doi={10.1109/ICCSC67078.2026.11468748},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11390486,
  author={N, Maheswaran and G, Logeswari and S, Bose and G, Gokulraj and G, Vijayaraj and D, Prabhu},
  booktitle={2025 International Conference on Intelligent Computing, Information and Control Systems (ICOIICS)}, 
  title={AIOPS-Enabled IoT Framework for Intelligent Early Warning and Disaster Management Systems}, 
  year={2025},
  volume={},
  number={},
  pages={885-891},
  abstract={Natural disasters pose significant threats to human life, infrastructure, and the environment, necessitating the development of intelligent and proactive disaster management systems. This chapter presents a novel AIOps-enabled IoT framework designed for early warning, risk assessment, and automated response in natural disaster scenarios such as floods, earthquakes, wildfires, and cyclones. The proposed framework integrates multi-source IoT sensor data with Artificial Intelligence for IT Operations (AIOps) to enable real-time monitoring, anomaly detection, predictive analytics, and automated decision-making. The system architecture comprises four core layers: the sensing layer for environmental data collection, the edge-fog-cloud integration layer for scalable data handling, the AIOps layer for deep learning-based analytics and alert generation, and the response layer for coordinated emergency action. Advanced machine learning models including CNN-LSTM for spatiotemporal forecasting and GNNs for topological event prediction are employed. Additionally, automated root cause analysis and feedback loops enhance the system's self-healing and adaptation capabilities. Case studies using open datasets validate the system's accuracy, responsiveness, and applicability in real-world scenarios. The chapter also discusses challenges such as data privacy, deployment in low-infrastructure areas, and real-time constraints. This AIOps-IoT synergy aims to revolutionize disaster management by offering faster, smarter, and more reliable early warning mechanisms.},
  keywords={Accuracy;Wildfires;Disasters;Disaster management;Real-time systems;Cyclones;Floods;Predictive analytics;Forecasting;Anomaly detection;AIOps;Anomaly Detection;Automated Alerts;CNN-LSTM;Cyclone Prediction;Data Fusion;Disaster Forecasting;Early Warning System;Earthquake Monitoring;Edge Computing;Emergency Response;Environmental Sensors;Flood Detection;GNN;IoT Framework;Machine Learning;Predictive Analytics;Real-Time Monitoring;Risk Assessment;Wildfire Detection},
  doi={10.1109/ICOIICS67115.2025.11390486},
  ISSN={},
  month={Nov},}
