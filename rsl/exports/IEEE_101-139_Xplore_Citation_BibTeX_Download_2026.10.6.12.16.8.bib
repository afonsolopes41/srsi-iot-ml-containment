  booktitle={2026 Eight International Conference on Computational Intelligence and Communication Technologies (CCICT)}, 
  title={AI is Reshaping Global Supply Chain Management}, 
  year={2026},
  volume={},
  number={},
  pages={184-189},
  abstract={The rapid evolution of Artificial Intelligence (AI) is fundamentally reshaping global supply chain management (SCM), enabling businesses to achieve unprecedented levels of efficiency, agility, and resilience. This paper explores the diverse applications of AI in SCM, including demand forecasting, inventory optimization, supplier relationship management, logistics, and risk mitigation. AIdriven predictive analytics leverage vast amounts of data to enhance accuracy in demand prediction, minimizing stock outs and overstocking. Machine learning algorithms optimize warehouse operations and streamline supply chain networks by identifying inefficiencies and recommending improvements. Autonomous systems, such as AI-powered robots and drones, are revolutionizing warehousing and last-mile delivery, reducing operational costs and improving order fulfillment speed. Moreover, this research paper signifies AI enhances supply chain visibility and risk management through real-time monitoring and anomaly detection, allowing companies to anticipate and respond to disruptions more effectively. The integration of AI with emerging technologies like the Internet of Things (IoT) and block chain enhances transparency, traceability, and security, ensuring compliance with global trade regulations. However, research paper explains the implementation of AI in SCM comes with challenges, including high initial costs, data privacy concerns, and the need for skilled professionals. Ethical considerations, such as the impact of AI on employment and decision-making biases, also require careful attention.},
  keywords={Artificial intelligence;Supply chains;Internet of Things;Supply chain management;Modeling;Logistics;Optimization;Technology;Artificial Intelligence (AI);Supply Chain Management (SCM);Machine Learning;Internet of Things (IoT);Blockchain;Supply Chain Visibility},
  doi={10.23919/CCICTCPS00010.2026.00039},
  ISSN={},
  month={April},}@INPROCEEDINGS{11222443,
  author={Sobchuk, Valentyn and Pykhnivskyi, Roman and Levenchuk, Liudmyla and Sobchuk, Andrii and Stepanchenko, Bogdan and Pankov, Andrii},
  booktitle={2024 IEEE 5th International Conference on Advanced Trends in Information Theory (ATIT)}, 
  title={The Method of Ensuring Functional Stability by Means of Sequential IDS for Cyber Protection Without Trust of IoT/IIoT Networks}, 
  year={2024},
  volume={},
  number={},
  pages={131-137},
  abstract={Ensuring the functional stability of complex technical systems is one of the critical challenges of our time. The rapid development of information and communication technologies demands new effective methods for threat monitoring to implement strategies for the uninterrupted operation of information infrastructure. The report presents an intrusion detection system (IDS) based on machine learning developed for the cyber defense of IoT/IIoT networks using the zero-trust principles. The developed IDS framework employs a sequential approach with two artificial intelligence modules: an attack detection module to identify malicious traffic and an attack classification module using models such as Random Forest or XGBoost to classify attack types. The proposed design aims to achieve high detection accuracy while maintaining low computational costs. This approach is crucial for real-time network monitoring in IoT environments. Integrating the IDS with a software-defined network (SDN) facilitates centralized control, dynamic security policy updates, and automated mitigation responses. Experimental evaluation on the Edge-IIoTset dataset demonstrates the system's efficiency with an overall accuracy of 95 % and significantly reduced inference time compared to single complex model approaches. The results emphasize the potential of the suggested IDS framework for real-world use in maintaining the functional stability of IoT/IIoT networks under the zero-trust security model. Additionally, this system's ability to adjust to different IoT situations highlights its flexibility and potential for widespread use.},
  keywords={Radio frequency;Accuracy;Biological system modeling;Intrusion detection;Stability analysis;Real-time systems;Thermal stability;Random forests;Monitoring;Industrial Internet of Things;functional stability;cybersecurity;zero-trust security;IoT;IIoT;intrusion detection;machine learning},
  doi={10.1109/ATIT64324.2024.11222443},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11706684,
  author={Albadi, Shamekh Ali and Alnuaimi, Rashed Omar and Murugan, Thangavel and Alnaqbi, Khalifa Omar and Alhashmi, Ahmed and Mohammed, Eissa Abdulla and Ahamed, N Nasurudeen},
  booktitle={2026 Student Multidisciplinary Innovation and Research Conference (SMIRC)}, 
  title={Research Study on AI Surveillance for Crowd Behavior, Density Estimation, and Health Monitoring}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Artificial intelligence (AI)-based smart surveillance refers to intelligent monitoring systems that automatically analyze video streams and identify anomalous activity in real time using deep learning, computer vision, and Internet of Things technologies. The increasing demand for enhanced public safety, effective crowd control, and continuous healthcare monitoring in densely populated metropolitan settings has made these technologies indispensable for smart cities. By facilitating crowd behavior anomaly detection, crowd density estimation, and vision-based health monitoring, all of which enable early threat identification, congestion mitigation, and quick emergency response, real-time video surveillance makes a substantial contribution to public safety. Nevertheless, there are several issues with current surveillance systems, including reliance on manual monitoring, slow response times, human error, scalability challenges, and inadequate integration between surveillance and health monitoring modules. Through automation, real-time warnings, predictive analytics, and precise detection capabilities using deep learning models such as CNNs, YOLO, and LSTMs, as well as multimodal frameworks, recent developments in AI have enhanced intelligent surveillance. This paper presents a study on AI-based smart surveillance systems for health monitoring, population density estimation, and behavior detection in smart cities.},
  keywords={Modeling;Internet of Things;Timing;Monitoring;Real-time systems;Surveillance;Occupational health;Videos;Wearable devices;Estimation;AI-Based Smart Surveillance;Crowd Behavior Detection;Crowd Density Estimation;Health Monitoring;Deep Learning;Smart Cities},
  doi={10.1109/SMIRC70459.2026.11706684},
  ISSN={},
  month={June},}@INPROCEEDINGS{9677429,
  author={Ali, Jokha},
  booktitle={2021 22nd International Arab Conference on Information Technology (ACIT)}, 
  title={Intrusion Detection Systems Trends to Counteract Growing Cyber-Attacks on Cyber-Physical Systems}, 
  year={2021},
  volume={},
  number={},
  pages={1-6},
  abstract={Cyber-Physical Systems (CPS) suffer from extendable vulnerabilities due to the convergence of the physical world with the cyber world, which makes it victim to a number of sophisticated cyber-attacks. The motives behind such attacks range from criminal enterprises to military, economic, espionage, political, and terrorism-related activities. Many governments are more concerned than ever with securing their critical infrastructure. One of the effective means of detecting threats and securing their infrastructure is the use of Intrusion Detection Systems (IDS) and Intrusion Prevention Systems (IPS). A number of studies have been conducted and proposed to assess the efficacy and effectiveness of IDS through the use of self-learning techniques, especially in the Industrial Control Systems (ICS) era. This paper investigates and analyzes the utilization of IDS systems and their proposed solutions used to enhance the effectiveness of such systems for CPS. The targeted data extraction was from 2011 to 2021 from five selected sources: IEEE, ACM, Springer, Wiley, and ScienceDirect. After applying the inclusion and exclusion criteria, 20 primary studies were selected from a total of 51 studies in the field of threat detection in CPS, ICS, SCADA systems, and the IoT. The outcome revealed the trends in recent research in this area and identified essential techniques to improve detection performance, accuracy, reliability, and robustness. In addition, this study also identified the most vulnerable target layer for cyber-attacks in CPS. Various challenges, opportunities, and solutions were identified. The findings can help scholars in the field learn about how machine learning (ML) methods are used in intrusion detection systems. As a future direction, more research should explore the benefits of ML to safeguard cyber-physical systems.},
  keywords={Integrated circuits;Terrorism;Industrial control;Intrusion detection;SCADA systems;Machine learning;Cyber-physical systems;Intrusion Detection Systems (IDS);Cyber Physical Systems (CPS);Systematic Literature Review (SLR);machine learning (ML);cyber-attacks},
  doi={10.1109/ACIT53391.2021.9677429},
  ISSN={},
  month={Dec},}@INBOOK{11505700,
  author={Kaur, Gaganjot and Shrivastava, Vineet and Khan, Surbhi Bhatia and Singh, Anshu},
  booktitle={Security and Privacy in 6G Communication Technology}, 
  title={Applications of Machine Learning in Strengthening 6G Security}, 
  year={2026},
  volume={},
  number={},
  pages={167-190},
  abstract={Summary <p>With the introduction and rise in the wireless communication, sixth&#x2010;generation (6G) technology scripts a trending and transformative era in today's world, especially defined by multiple benefits including ultra&#x2010;low latency, more than a million&#x2010;device connectivity, high and very&#x2010;high data speeds, and advance technologies such as artificial intelligence (AI), machine learning (ML), blockchain, and quantum computing integration. These advancements enable unparalleled capabilities across domains, including, but not limited to, the Internet of Things, ultra&#x2010;modern smart cities, autonomous vehicles, and extended reality. However, the novel features of 6G also present significant security challenges, requiring robust strategies to ensure data integrity, privacy, and network reliability. Henceforth, focusing on this, the present research explores the vital and essential role of ML in enhancing security and highlighting its applications in dynamic threat detection, predictive maintenance, automated response systems, and anomaly detection. By employing the real time data analysis, the advanced ML algorithms deliver adaptive and intelligent responses to security breaches, optimizing network resilience and overall system efficiency. In addition to this, this present work also examines the integration of ML with other advanced technologies such as quantum&#x2010;safe cryptography and decentralized authentication systems to strengthen the 6G security framework. Conclusively, considering the aspects and scope of 6G in the future, the comprehensive analysis presented in this paper highlights the essential role of ML in building resilient, adaptive, and secure communication infrastructures for the upcoming wireless technology generation, settling in the foundation for sustainable and reliable AI&#x2010;driven 6G ecosystems.</p>},
  keywords={Communications technology;Communication systems;Internet of Things;Internet;Wireless communication;5G mobile communication;Cellular technology;Mobile communication;Computer networks;Wireless networks},
  doi={10.1002/9781394311057.ch8},
  ISSN={},
  publisher={Wiley},
  isbn={9781394311033},
  url={https://ieeexplore.ieee.org/document/11505700},}@ARTICLE{9391735,
  author={Saba, Tanzila and Sadad, Tariq and Rehman, Amjad and Mehmood, Zahid and Javaid, Qaisar},
  journal={IT Professional}, 
  title={Intrusion Detection System Through Advance Machine Learning for the Internet of Things Networks}, 
  year={2021},
  volume={23},
  number={2},
  pages={58-64},
  abstract={Network security is the main issue in the Internet of Things networks because most manufacturers do not focus on security standards during design. The performance of firewalls, intrusion prevention systems, and intrusion detection systems depend upon accuracy, thus its essentials, to enhance the detection rate to lessen false alarms. The objective of the firewall is to find violations as per predefined rules and block the incoming risky traffic. However, it is very tough to differentiate between malicious and regular traffic due to advanced techniques of attack. To address these issues, a two-stage hybrid method is proposed. First, the genetic algorithm (GA) is applied to select appropriate features to improve the accuracy of the proposed framework. Next, the well-known machine learning (ML) algorithm, including the support vector machine (SVM), ensemble classifier, and decision tree are employed. The achieved accuracy is 99.8% through 10-fold cross-validation using a multiclass NSL-KDD database.},
  keywords={Network security;Internet of Things;Security;Support vector machines;Genetic algorithms;Machine learning;Telecommunications traffic},
  doi={10.1109/MITP.2020.2992710},
  ISSN={1941-045X},
  month={March},}@INPROCEEDINGS{11275544,
  author={Benelhaouare, Amrou Zyad and Saydé, Michel and Mellal, Idir and Oumlaz, Maroua and Nicolescu, Gabriela and Lakhssassi, Ahmed},
  booktitle={2025 IEEE Global Conference on Artificial Intelligence and Internet of Things (GCAIoT)}, 
  title={Proactive TSCA Detection via Real-Time Thermal Signature Modeling on Low-Power IoT Devices}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={In this paper, we introduce a real-time thermal signature modeling approach for embedded IoT systems as a proactive countermeasure against Thermal Side-Channel Attacks (TSCA). Rather than designing new sensing hardware, we exploit the ESP32-S3’s native on-die temperature sensor an 8 bit sigmadelta ADC with factory trimmed DAC that delivers $\simeq \mathbf{0. 2}{ }^{\circ} \mathrm{C} / \mathrm{LSB}$ resolution and $\pm 5{ }^{\circ} \mathrm{C}$ absolute accuracy across its $-40{ }^{\circ} \mathrm{C}$ to $+125{ }^{\circ} \mathrm{C}$ range to capture core junction temperature directly. Using a three stepper motor control case study, we record the chip’s thermal evolution under four operational loads (idle, one, two, and three motor scenarios) and log the data in structured CSV files. These profiles form a comprehensive dataset of normal operation signatures, laying the groundwork for lightweight, ondevice anomaly detection and future deployment of machine learning-based digital twin models. Our results demonstrate how existing, low cost thermal sensors can be harnessed for thermal profiling, integrating core level signature awareness into resource constrained IoT devices without external components or high overhead methods.},
  keywords={Temperature sensors;Temperature distribution;Side-channel attacks;Real-time systems;Sensor systems;Thermal analysis;Internet of Things;Thermal loading;Security;Load modeling;embedded IoT systems;real-time;thermal signature;thermal side-channel attacks (TSCA);ESP32-S3;digitaltwin},
  doi={10.1109/GCAIoT68269.2025.11275544},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11432109,
  author={Kejriwal, Vanshika and Sivaraman, Vignesh and Nalam, Venkata Abhishek},
  booktitle={GLOBECOM 2025 - 2025 IEEE Global Communications Conference}, 
  title={FairTabFormer: Mitigating Bias in Synthetic Network Traffic Data}, 
  year={2025},
  volume={},
  number={},
  pages={4511-4516},
  abstract={Synthetic data generation has emerged as a promising approach to address challenges related to data scarcity, privacy constraints, and bias mitigation in machine learning applications. In networking, especially intrusion detection systems (IDS), access to balanced and unbiased datasets is critical for developing robust models. However, real-world network traffic datasets often exhibit significant class imbalance and encode discriminatory patterns across sensitive attributes, which can result in unfair decision-making. This paper proposes FairTabFormer, a transformer-based generative model tailored to produce realistic, fair, tabular synthetic network traffic data. Based on the GPT-2 decoder architecture, FairTabFormer integrates a fairness-aware training paradigm that penalizes disparity in prediction distributions across sensitive groups, specifically targeting protocol types in intrusion detection datasets. The model leverages a custom loss function that combines cross-entropy with fairness regularization, ensuring demographic parity in the generated data. The experimental evaluation uses the CIC IoT23 dataset, a comprehensive benchmark for IoT-based threat detection. The downstream performance is assessed using an XGBoost classifier using accuracy as the primary utility metric, while fairness is measured using the Demographic Parity Ratio (DPR) and the Demographic Parity Difference (DPD). Comparative results against state-of-the-art models such as CTGAN and REaLTabFormer demonstrate that FairTabFormer achieves superior fairness while maintaining high predictive utility. These findings underscore its potential to enhance fairness without compromising data quality.},
  keywords={Measurement;Training;Prevention and mitigation;Intrusion detection;Telecommunication traffic;Predictive models;Transformers;Data models;Threat assessment;Synthetic data;Fairness;transformer;synthetic data;tabular data generation},
  doi={10.1109/GLOBECOM59602.2025.11432109},
  ISSN={2576-6813},
  month={Dec},}@INPROCEEDINGS{11203733,
  author={Rongali, Sateesh Kumar},
  booktitle={2025 International Conference on Artificial Intelligence and Machine Vision (AIMV)}, 
  title={AI-Powered Threat Detection in Healthcare Data}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={The increasing digitization of healthcare data has made it a prime target for cyber threats, necessitating advanced security mechanisms for real-time threat detection and mitigation. This study explores the application of AI-powered threat detection in healthcare cybersecurity using Health Information Sharing and Analysis Center (H-ISAC) Cyber Threat Intelligence Feeds, which provide real-world cyber threat indicators, including unauthorized access attempts (42.3%), malware infections (31.2%), and phishing attacks (26.5%). The proposed framework integrates machine learning-based anomaly detection techniques, supervised classification models, and behavioral analytics to enhance cybersecurity monitoring. Experimental results demonstrate that the Neural Network model achieved the highest accuracy (96.3%) with the lowest false positive rate (2.9%), followed by Random Forest (94.5% accuracy, 3.8% false positives) and Isolation Forest (89.1% accuracy, 7.2% false positives). The study confirms that AI-driven security frameworks outperform traditional rule-based detection, improving cyber threat intelligence processing, automated attack mitigation, and compliance with the Health Insurance Portability and Accountability Act (HIPAA) and the General Data Protection Regulation (GDPR). The findings emphasize the necessity of AI-based security solutions to protect electronic health records (EHRs), medical IoT devices, and healthcare IT infrastructures from evolving cyber threats while ensuring high detection accuracy and reducing alert fatigue for security teams.},
  keywords={Accuracy;Prevention and mitigation;Phishing;Neural networks;Medical services;Threat assessment;Real-time systems;Cyber threat intelligence;General Data Protection Regulation;Anomaly detection;AI-powered cybersecurity;healthcare data security;threat intelligence;H-ISAC dataset;anomaly detection;ransomware detection;phishing prevention;machine learning;intrusion detection;HIPAA compliance;neural networks;data protection},
  doi={10.1109/AIMV66517.2025.11203733},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{10456258,
  author={Ganesh, Narayanan and Parihar, Arpan Singh and Ghosh, Gourav},
  booktitle={2023 IEEE International Conference on ICT in Business Industry & Government (ICTBIG)}, 
  title={Analysing Network Traffic and Implementing Diverse Technologies to Examine Different Components of the Network}, 
  year={2023},
  volume={},
  number={},
  pages={1-10},
  abstract={This paper comprehensively explores network traffic analysis using various technologies, focusing on dynamic analysis for malware study with Sandnet as an analysis environment. It investigates DNS and HTTP usage by malware, considers ethics and risk mitigation, and delves into machine learning-based IoT device identification. The study introduces a multi-stage meta classifier methodology to enhance IoT device classification, discusses network traffic predictability, and highlights intrusion detection using packet sniffers for security. By addressing these topics, the paper significantly contributes to network traffic analysis understanding, its application, and implications for network security and control.},
  keywords={Government;Intrusion detection;Focusing;Telecommunication traffic;Network security;Malware;Internet of Things;BPF kernel device;DNS;HTTP;IoT devices;Libpcap library;NIC card;Sandnet;network behavior;command and control servers;dynamic analysis;ethical considerations;header formats;intrusion detection;machine learning;malware study;meta classifier;network control;network traffic analysis;packet sniffers;predictability of network traffic;promiscuous mode;protocol interpretation;risk mitigation;sandbox;security threats;vulnerabilities},
  doi={10.1109/ICTBIG59752.2023.10456258},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11195011,
  author={Khandan, Shokooh and Beyazgul, Deniz and Jogunola, Olamide and Tsado, Yakubu and Dargahi, Tooska},
  booktitle={2025 IEEE Conference on Communications and Network Security (CNS)}, 
  title={Explainable AI-Driven Threat Detection and Response for Industrial IoT}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The growing complexity and volume of cyber attacks to Cyber-Physical Systems (CPS) and Industrial Internet of Things (IIoT) have outpaced traditional detection methods, requiring more intelligent and explainable security solutions. While Artificial Intelligence (AI)-based anomaly detection solutions have been proposed in the literature, they either focus on a single type of attack, or their decisions are restricted based on a single dataset, or they lack transparency. To address these challenges, this paper presents an explainable attack detection framework for IIoT, combining advanced machine learning (ML) models and AI-driven interpretability. The framework employs mid-level and late data fusion techniques on two IIoT datasets, using Autoencoders (AE) and Manifold Alignment (MA) techniques to generate a unified feature space. A Random Forest (RF) classifier is trained on the fused dataset to detect four attack types, achieving a 97% accuracy. The model's decision-making is made transparent through Explainable AI (XAI) tools, providing both global and local interpretability. Furthermore, a Large Language Model (LLM)-powered AI assistant is developed to provide automated, context-aware mitigation strategies based on MITRE D3FEND framework. This integrated approach enhances the detection, interpretability, and response to threats in IIoT environments, promoting greater trust and operational resilience.},
  keywords={Accuracy;Explainable AI;Prevention and mitigation;Decision making;Data integration;Cyber-physical systems;Threat assessment;Cyberattack;Industrial Internet of Things;Classification tree analysis;Explainable AI;Cyber-Physical Systems;Industrial IoT;Cyber Attack Detection},
  doi={10.1109/CNS66487.2025.11195011},
  ISSN={2994-5895},
  month={Sep.},}@INPROCEEDINGS{11631367,
  author={Alam, Samiul and Clark, George W.},
  booktitle={2026 7th International Conference on Artificial Intelligence, Robotics, and Control (AIRC)}, 
  title={AutomotiveIDS: A Review of ML Techniques and Introducing NLPSA to Robotics}, 
  year={2026},
  volume={},
  number={},
  pages={328-333},
  abstract={The growing use of advanced technology to assist and make convenience in road transportation and safety is helping to keep the automotive market competitive. This also opens newer security threats, discovered or undiscovered, to machines and robots in the form of automobiles. Several types of attacks have been performed using experiments and a handful of mitigation techniques have been explored. Whilst serving their purpose, insecure sensors remain cyberattack prone. This study views the intrusion detection system (IDS) as the ideology to detect a man-in-the-middle (MITM) attack. We have reviewed literature to find the use of machine learning (ML) methods to analyze network data and detect MITM attacks. We have found that Random Forest and Support Vector Machine are some of the more prominent methods adapted in IoT MITM attacks. We introduce that nonlinear phase space analysis (NLPSA), a network attack analysis algorithm, is not a widely used technique to analyze and detect attack. We summarized the published works to understand the use of machine learning methods in IDS and find the gap for NLPSA to fit as a technique to perform detection analysis.},
  keywords={Vehicles;Printing;Automotive engineering;Timing;Controller area networks;Internet of Things;Machine learning;Modeling;Conferences;Signal detection;intrusion;automotive;robots;attack;man-in-the-middle},
  doi={10.1109/AIRC69745.2026.11631367},
  ISSN={},
  month={April},}@INPROCEEDINGS{11526626,
  author={Lakshmi, B. and B S, Namratha and Jain, Shubhi and Kumbhar, Vijaya and Alaskar, Kamal and Naveenkumar, R.},
  booktitle={2026 13th International Conference on Computing for Sustainable Global Development (INDIACom)}, 
  title={Adaptive Security Orchestration in High-Speed SDN/NFV Architectures}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={Dynamic communication architectures based on Software Defined Networking (SDN) and Network Function Virtualization (NFV) ensure flexibility, programmability and scalability of the network infrastructures itself tailored to the needs of modern-day Cloud, IoT, and $5 \mathrm{G} / 6 \mathrm{G}$ ecosystems. On the other hand, SDN's centralized control plane and dynamic network function virtualization can create new security vulnerabilities such as distributed attacks, unauthorized access, and fast threat propagation across virtualized resources[76]. This paper presents a high-speed SDN/NFV oriented Adaptive Security Orchestration Framework (ASOF) to cope up with the aforementioned challenges. This pooling of intelligent threat detection, dynamic policy enforcement, and automated response mechanisms will be orchestrated through a centralized layer. Anomaly detection was carried out with data on the existing flows of traffic using a machine-learning-assisted module, while an orchestration engine dete threats and dynamically reconfigured available virtual network functions and relevant security policies. Based on experimental evaluation on a simulated SDN/NFV testbed, the proposed approach significantly enhances network resilience and reduces attack response time. The experimental results indicate that the proposed adaptive orchestration mechanism can reach 94.8% threat detection accuracy with a 37% drop in incident response latency and 29% higher overall network security efficiency comparing to conventional static security frameworks. The architecture can dynamically adjust to the need of systems to provide an intelligent and scalable solution for securing future high-speed programmable networks.},
  keywords={Modeling;Security;Machine learning;Software defined networking;Network function virtualization;Fluid flow;Equations;Timing;Printing;Anomaly detection;Personalized Recommendation Systems;Generative Intelligence;Deep Learning;User Preference Modeling;Cold-Start Problem;Context-Aware Recommendations;Intelligent Information Systems},
  doi={10.23919/INDIACom70271.2026.11526626},
  ISSN={},
  month={April},}@INPROCEEDINGS{11566359,
  author={Sunny, Sherin and Siddiqa, Hafza Ayesha and Khan, Jan Sher},
  booktitle={2026 2nd International Conference on Intelligent Systems and Computational Networks (ICISCN)}, 
  title={Explainable and Adaptive Intrusion Detection Framework Using TON_IoT Telemetry for Cloud Computing}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={The growing dependence on cloud environments raises security concerns i.e., cyber threats. To mitigate such threats, efficient and robust Intrusion Detection Systems (IDS) must be designed. A traditional network-based IDS may not be able to capture low-level system behaviors that are crucial to identifying stealthy attacks. Therefore, an adaptive and explainable IDS based on the telemetry TON_IoT 2020 dataset is proposed. TabNet-based deep learning, explainable artificial intelligence (XAI), and automated decision-response layers are also incorporated in the designed system. Moreover, attack types are classified, predictions are mapped to severity levels, and mitigation strategies are executed. To incorporate adaptability, misclassifications are continuously learned. The proposed IDS model demonstrated 95.38 % accuracy, a MCC of 0.949, and a Cohen's kappa of 0.947 for eight different attack classes. XAI visualizations, including UMAP 3D projections and global feature importance, increase interpretability and reduce response latency.},
  keywords={Modeling;Clouds;Internet of Things;Printing;Intrusion detection;Cloud computing;Training;Media;Joining processes;Telemetry;Cloud Computing;Security;Intrusion Detection;Explainable AI;Tomek Links;Feature Selection},
  doi={10.1109/ICISCN67954.2026.11566359},
  ISSN={},
  month={April},}@ARTICLE{11479565,
  author={Ahmad, Nouman and Sehar, Uroosa and Zhou, Jianhua and Peng, Yifei and Zhang, Changsheng},
  journal={IEEE Access}, 
  title={Harnessing LLMs for Cyber-Resilience: A Systematic Survey in Threat Mitigation and Future Trajectories}, 
  year={2026},
  volume={14},
  number={},
  pages={61294-61315},
  abstract={By enabling contextual reasoning, adaptive defense mechanisms, and intelligent threat detection, the quick development of LLMs has drastically changed the cybersecurity landscape. LLMs provide a single framework that can comprehend complex cyber threats across disparate data sources, in contrast to standard machine learning approaches that mostly rely on handcrafted features and task-specific models. With a focus on domain-specific fine-tuning techniques and web content protection, this research methodically investigates how LLMs are used to promote AI-driven cybersecurity. A structured keyword selection and screening process was carried out in accordance with PRISMA criteria, yielding a curated collection of representative phrases that directed the literature investigation. For cybersecurity activities like phishing and spam detection, cyber threat intelligence, intrusion detection, malicious URL identification, DDoS mitigation, and IoT security, the report summarizes recent research on optimized LLMs. In order to adapt general-purpose LLMs to security-sensitive contexts, special attention is paid to parameter-efficient fine-tuning techniques, continuous pretraining, and instruction tweaking. Additionally, this research demonstrates how LLMs improve the security of web content by using contextual knowledge and reasoning to detect emerging dangers and social engineering assaults that circumvent conventional rule-based systems. This paper offers a succinct of the state of LLM-driven cybersecurity research by classifying the literature into logical subject areas and using graph-based representations to visualize keyword correlations. The review seeks to assist researchers and practitioners in comprehending current approaches, pointing out constraints, and spotting new trends in the safe and efficient use of LLMs for cybersecurity operations.},
  keywords={Payloads;Aerospace and electronic systems;Telemetry;Military aircraft;Space technology;Feeds;Filtering;Filters;Feedback;Circuits;Cybersecurity;information extraction;large language models;threat mitigation;fine-tuning;web content protection},
  doi={10.1109/ACCESS.2026.3682720},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11139927,
  author={El-Hajj, Mohammed},
  booktitle={2025 5th Intelligent Cybersecurity Conference (ICSC)}, 
  title={AI-Powered Threat Detection and Response: Leveraging Machine Learning for Real-Time Intrusion Detection Systems (IDS) Using Network Traffic Data}, 
  year={2025},
  volume={},
  number={},
  pages={84-90},
  abstract={The growing complexity of cyberattacks necessitates advanced intrusion detection systems (IDS) capable of real-time threat identification. This study proposes a hybrid machine learning (ML) framework to enhance IDS by combining static and temporal analysis of network traffic. Leveraging benchmark datasets—CICIDS2017, UNSW-NB15, and KDD Cup 1999—we developed a model integrating Random Forest (RF) for static feature interpretation and Long Short-Term Memory (LSTM) networks for sequential pattern recognition. Data preprocessing included SMOTE-ENN for class imbalance mitigation and mutual information for feature selection. Deployed on an edge-compatible pipeline using Apache Kafka and TensorRT, the framework achieved a 98.7% F1-score and 99.2% AUC-ROC on CICIDS2017, outperforming state-of-the-art models like CNNs and SVMs. Real-time testing demonstrated a latency of 4.2 ms and throughput of 12,000 requests/second, surpassing existing approaches by 60%. Case studies confirmed robust detection of DDoS, brute force, and SQL injection attacks with ¡1% false positives. This work bridges the gap between accuracy and speed in ML-based IDS, offering a scalable solution for IoT, industrial control systems, and 5G networks. Future research will focus on encrypted traffic analysis and federated learning for decentralized deployment.},
  keywords={Accuracy;Federated learning;5G mobile communication;Image edge detection;Intrusion detection;Telecommunication traffic;Real-time systems;Cryptography;Long short term memory;Random forests;Intrusion Detection System (IDS);Machine Learning;Real-Time Detection;Network Traffic;CICIDS2017;UNSW-NB15;KDD Cup 1999;Hybrid Models},
  doi={10.1109/ICSC65596.2025.11139927},
  ISSN={},
  month={May},}@INPROCEEDINGS{11549047,
  author={Balasubramani, M. and Arivarasan, S. and R, Arulamuthan and V, Harish and B, Jayakumar and S, Logesh},
  booktitle={2026 ASU International Conference in Emerging Technologies for Sustainability and Intelligent Systems (ICETSIS)}, 
  title={An Intelligent DDoS Protection Architecture for Secure and Scalable Cloud Systems}, 
  year={2026},
  volume={},
  number={},
  pages={1263-1270},
  abstract={Smart city services such as real-time traffic prediction and city analytics rely on DDoS protection to have secure and scalable cloud systems. As the latency of transportation and IoT applications is increasingly placed on cloud platforms, resilient network defense is becoming central. Current DDoS mitigation strategies rely on fixed thresholds, signature-based intrusion detection, or centralized filtering, which fail to respond to dynamic cloud traffic patterns. Such approaches have a high false-positive rate and do not generalize well to zero-day attacks that result from changes in smart city traffic patterns. The architecture is a proposal for a cloud-native DDoS protection framework that combines real-time traffic observation, evolutionary feature engineering, and hybrid machine learning. Learned XGBoost instances of known volumetric and protocollevel attack signatures, and a Long Short-Term Memory autoencoder instance learns normal spatio-temporal traffic behavior to detect anomalies and zero-day attacks. The architecture is implemented across cloud-edge models and core models to secure traffic prediction, connected vehicles, roadside units, and city control platforms. The system adjusts security enforcement to smart city dynamics by learning temporal correlations in the mobility-driven network traffic. The experimental results show high detection accuracy, a higher F1score, and lower response time under large-scale attack conditions. The findings validate increased scalability, strength, and foresight, which will facilitate secure traffic intelligence in the cloud for future smart city applications.},
  keywords={Clouds;Printing;Modeling;Internet of Things;Urban areas;Timing;Smart cities;Cloud computing;Signal detection;Distributed denial-of-service attack;Distributed Denial of Service;Cloud Security;Hybrid Machine Learning;Traffic Prediction;Smart Cities},
  doi={10.1109/ICETSIS68266.2026.11549047},
  ISSN={},
  month={May},}@INPROCEEDINGS{11656434,
  author={Prakash, P. Arul and A, Salath Joseph and M, Akash Madhavan and S, Aswath and K, Sudharsan and C, Vignesh Manikandan},
  booktitle={2026 7th International Conference on Smart Systems and Inventive Technology (ICSSIT)}, 
  title={Explainable AI and Machine Learning Framework for Cyber Threat Detection and Adaptive Defense Systems}, 
  year={2026},
  volume={},
  number={},
  pages={706-712},
  abstract={Advanced persistent threats, zero-day exploits, encrypted command-and-control traffic, and botnet campaigns continue to reduce the reliability of conventional intrusion detection systems because static detectors provide limited transparency and weak adaptation under traffic drift. This paper presents an explainable and adaptive machine learning framework that integrates a LightGBM threat detector, SHAP-based decision explanations, density-aware concept drift detection, active incremental updating, and a contextual bandit defense policy. LightGBM is adopted because its leaf-wise gradient boosting structure provides high discrimination for heterogeneous flow features while maintaining low inference latency and native feature-importance support. The framework is evaluated on CIC-IDS2017, UNSW-NB15, and ToN_IoT using stratified train-validation-test splits, leakage prevention, five-run validation, and a 48-hour Kafka-based streaming simulation. The proposed model achieved 99.1% accuracy, 98.7% F1-score, 98.4% recall, and a 0.007 false alarm rate. During streaming evaluation, 14 adaptive model updates reduced mean detection latency from 27.4 s to 11.2 s, while SHAP explanations based on DNS entropy, JA3 rarity, packet interval, and flow-duration evidence reduced analyst triage time by 23%. Comparative results show that the proposed explainable adaptive pipeline improves detection reliability, reduces false alarms, and supports auditable mitigation decisions better than static and black-box IDS baselines.},
  keywords={Modeling;Internet of Things;Signal detection;Printing;Labeling;Intrusion detection;Explainable AI;Fluid flow;Machine learning;Concept drift;Explainable AI;cyber threat detection;adaptive defense;SHAP;intrusion detection systems},
  doi={10.1109/ICSSIT69151.2026.11656434},
  ISSN={},
  month={July},}@INPROCEEDINGS{11212608,
  author={Vaishnavi, T and Al-Safarini, Maram Y. and Nalini, N and Stalin, T and Laxmi and Dinesh, M.},
  booktitle={2025 6th International Conference on Electronics and Sustainable Communication Systems (ICESC)}, 
  title={Advanced IoT-Integrated Child Safety Framework using Predictive Geo-Behavioral Algorithm and Real-Time Virtual Safety Mesh}, 
  year={2025},
  volume={},
  number={},
  pages={652-658},
  abstract={Ensuring child safety in dynamic environments requires intelligent, context-aware systems capable of anticipating risks before they occur. This paper introduces an IoT-driven wearable framework powered by the Enhanced Context-Aware Risk Prediction Algorithm (ECARPA). Unlike traditional geofencing systems that rely on static boundaries, ECARPA leverages behavioural trajectory forecasting, real-time physiological monitoring, and environmental context to generate adaptive virtual safety zones. The system integrates a multi-sensor AI-Locket wearable with a secure cloud-based parent dashboard, enabling real-time location tracking, anomaly detection, and predictive alert generation. Through multi-source data fusion and machine learning-based motion modelling, ECARPA ensures minimal false positives while maintaining high responsiveness. Experimental evaluations demonstrate the proposed system’s superior performance in terms of accuracy, risk mitigation, and alert latency. This work offers a comprehensive, scalable, and ethically conscious solution for next-generation child protection in smart environments.},
  keywords={Pediatrics;Accuracy;Heuristic algorithms;Prediction algorithms;Real-time systems;Safety;Trajectory;Cryptography;Biomedical monitoring;Monitoring;Enhanced Context-Aware Risk Prediction Algorithm (ECARPA);IoT-integrated child safety system;Adaptive virtual safety zones;AI-Locket wearable device;Real-time physiological monitoring;Behavioral trajectory prediction;Multi-source sensor fusion;Encrypted mobile-cloud communication},
  doi={10.1109/ICESC65114.2025.11212608},
  ISSN={2996-5357},
  month={Sep.},}@ARTICLE{11049662,
  author={Illy, Poulmanogo and Kaddoum, Georges and de Araujo-Filho, Paulo Freitas and Kaur, Kuljeet and Garg, Sahil},
  journal={IEEE Transactions on Network and Service Management}, 
  title={Retraction Notice A Hybrid Multistage DNN-Based Collaborative IDPS for High-Risk Smart Factory Networks}, 
  year={2025},
  volume={22},
  number={4},
  pages={3743-3743},
  abstract={New industrial control systems (ICSs) that have been modernized with the industrial Internet of Things (IIoT) are exposed to cyber-attacks that exploit IIoT vulnerabilities. Numerous intrusion detection systems (IDSs) have therefore been proposed to secure ICSs, many of which are based on machine learning, specifically deep neural networks (DNNs). Most of the proposed DNN-based solutions rely on single deep learning models and could be less costly in terms of ICS latency. However, they might have difficulties understanding the increasingly complex data distribution of intrusion patterns. Moreover, single deep learning models may not be effective in capturing the specific patterns of minority classes in highly imbalanced datasets, which is usually the case in cyber-security. Therefore, this paper proposes a novel hybrid multistage DNN-based intrusion detection and prevention system (IDPS) with better accuracy for critical ICSs that cannot afford to compromise on security to improve latency. The proposed approach sequentially learns the decision boundaries of the data that were misclassified or classified with low confidence by previous DNNs. Moreover, it incorporates a collaborative intrusion prevention system (IPS) with an emergency response schema that automatically mitigates attacks as soon as anomalies are detected. The results of experimental evaluations performed on different datasets demonstrate the effectiveness ofthe proposed solution.},
  keywords={},
  doi={10.1109/TNSM.2025.3582121},
  ISSN={1932-4537},
  month={Aug},}@INPROCEEDINGS{11355106,
  author={Isnaini, Khairunnisak Nur and Khoirunnita, Anisaa Qothrunnada and Suhartono, Didit},
  booktitle={2025 9th International Conference on Information Technology, Information Systems and Electrical Engineering (ICITISEE)}, 
  title={IoT Security: Security Privacy Mechanisms and Future Research Direction}, 
  year={2025},
  volume={},
  number={},
  pages={246-251},
  abstract={The development of the Internet of Things (IoT) has brought about major transformations in various sectors, ranging from industry, healthcare, transportation, to households. However, the rapid adoption of IoT also poses serious challenges related to data security and privacy, given the increasing number of devices that often have limited resources and inherent vulnerabilities. This article comprehensively discusses security mechanisms in the IoT ecosystem, including authentication and authorization, data encryption, and network segmentation, which play a crucial role in maintaining the confidentiality, integrity, and availability of information. In addition, an analysis of major threats such as Distributed Denial of Service (DDoS) attacks, IoT botnets, data theft, privacy violations, and Man-in-theMiddle (MitM) attacks is also presented to illustrate the complexity of security challenges. Furthermore, the identified future research directions include the use of artificial intelligence (AI) and machine learning (ML) for real-time anomaly detection and attack mitigation, blockchain integration to strengthen decentralization and data integrity, and the importance of multidisciplinary collaboration to build a resilient and trusted IoT ecosystem. The results of this study are expected to serve as a foundation for the development of more adaptive, innovative, and sustainable security strategies in the face of the ever-evolving IoT threat landscape.},
  keywords={IoT Security;Privacy Mechanisms;Cybersecurity;Future Research Direction},
  doi={10.1109/ICITISEE68184.2025.11355106},
  ISSN={},
  month={Dec},}
