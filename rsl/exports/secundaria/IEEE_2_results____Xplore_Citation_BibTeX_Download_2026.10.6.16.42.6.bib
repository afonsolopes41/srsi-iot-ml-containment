@INPROCEEDINGS{11189602,
  author={Ureche, Traian-Cristian and Boicescu, Laurențiu and Raducanu, Mircea and Popovici, Eduard-Cristian and Halunga, Simona and Vizireanu, Dragos Nicolae},
  booktitle={2025 IEEE 2nd International Conference on Blockchain, Smart Healthcare and Emerging Technologies (SmartBlock4Health)}, 
  title={The Convergence of Emerging Technologies and AI-Driven Autonomous Cybersecurity in Smart Digital Ecosystems}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The increasing complexity of smart digital ecosystems, encompassing smart logistics, the Internet of Things (IoT), digital transformation, and emerging technologies, has significantly expanded the attack surface for cyber threats. Traditional cybersecurity approaches struggle to address the dynamic nature of these threats, necessitating the integration of artificial intelligence (AI)-driven autonomous cybersecurity frameworks. This paper provides a systematic literature review on the convergence of emerging technologies and AI-driven cybersecurity solutions, emphasizing their role in enabling real-time anomaly detection, proactive threat mitigation, and self-adaptive cybersecurity architectures. The study explores AI techniques such as deep learning, behavior-based analytics, and reinforcement learning, applied across multiple domains, including smart infrastructure, industrial IoT, healthcare, and critical digital services. Additionally, we introduce agent-based AI systems as a paradigm shift in autonomous cybersecurity, leveraging multi-agent collaboration, retrieval-augmented generation (RAG), and distributed threat intelligence to enhance security resilience. The paper further examines the integration of AI with emerging cybersecurity frameworks, such as federated learning, quantum cryptography, and AI-powered security automation. Lastly, we discuss key challenges, including interoperability, computational scalability, regulatory compliance, and adversarial AI threats. The findings underscore the pivotal role of AI and autonomous agents in securing interconnected smart ecosystems against evolving cyber threats.},
  keywords={Prevention and mitigation;Scalability;Ecosystems;Retrieval augmented generation;Medical services;Computer security;Artificial intelligence;Convergence;Systematic literature review;Resilience;artificial intelligence;autonomous cybersecurity;emerging technologies;smart digital ecosystems;threat mitigation},
  doi={10.1109/SmartBlock4Health64843.2025.11189602},
  ISSN={},
  month={June},}@INPROCEEDINGS{11390140,
  author={Bhardwaj, Arth and Srivastava, Santosh Kumar and Sagar, Pinki and Mahto, Manoj Kumar},
  booktitle={2025 1st IEEE Uttar Pradesh Section Women in Engineering International Conference on Electrical Electronics and Computer Engineering (UPWIECON)}, 
  title={A Systematic Review of Threat Intelligence and Intrusion Detection Systems in Cybersecurity Architecture}, 
  year={2025},
  volume={},
  number={},
  pages={787-792},
  abstract={With cyber threats becoming more frequent and complex, and as our digital systems grow increasingly connected, Threat Intelligence (TI) and Intrusion Detection Systems (IDS) have taken on a vital role in shaping modern cyber security defenses. This paper offers a systematic review of recent studies, highlighting maj or advancements, integration strategies, and the challenges involved in combining TI and IDS within enterprise, cloud, and Internet of Things (IoT) environments. Using a PRISMA-guided selection and structured data extraction process, the review identifies four dominant research directions: intelligence-driven data fusion, machine learning-assisted detection, adversarial robustness, and automated response orchestration. The analysis indicates that the convergence of TI with AI-powered IDS frameworks substantially strengthens detection precision and situational awareness. However, practical implementations continue to encounter limitations related to data quality, computational scalability, and real-time adaptability. To fill the existing gap in research, this study try to make a common taxonomy that connects Threat Intelligence (TI) data with different Intrusion Detection System (IDS) models. The work also shows some continuous problems like no proper standards for threat data, less privacy when sharing info, and difficulty in making same test results again. The review shows that TI and IDS are slowly moving together towards more smart, explainable and strong systems which will be the main part of the next zero trust cyber security setups.},
  keywords={Taxonomy;Intrusion detection;Computer architecture;Machine learning;Threat assessment;Zero Trust;Internet of Things;Computer crime;Systematic literature review;Resilience;Threat Intelligence (TI);Intrusion Detection System (IDS);Cyber Security Architecture;Machine Learning;Systematic Review;Cloud Security;Internet of Thing (IoT);PRISMA;Zero Trust;Adversarial Resilience},
  doi={10.1109/UPWIECON67212.2025.11390140},
