# Dados e artefactos grandes não vão para o Git, exceto os dados já processados (58 MB)
data/*
!data/processed/
!data/README.md
!data/splits.json
pcaps/*
!pcaps/README.md
logs/
results/**/logs/
*.pcap
*.pcapng
*.parquet
*.egg-info/
.pytest_cache/

# Amostras pequenas usadas nos testes
!tests/dados/*.log

# Exceção: dados processados do IoT-23 (partilhados pelo Git)
!data/processed/*.parquet
