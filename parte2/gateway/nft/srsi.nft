#!/usr/sbin/nft -f
# Tabela do gateway (PEP). Contrato em docs/interfaces.md §5.
# O entrypoint substitui "timeout 300s" pelo valor de QUARANTINE_TIMEOUT.

table inet srsi
delete table inet srsi

table inet srsi {
	# Dispositivos em quarentena. Cada elemento expira sozinho; voltar a adicioná-lo renova-o.
	set quarantine {
		type ipv4_addr
		flags timeout
		timeout 300s
	}

	chain forward {
		type filter hook forward priority filter; policy accept;

		# 1) Quarentena: TEM de vir antes de established/related para cortar ligações já abertas.
		ip saddr @quarantine counter drop comment "srsi-quarentena-origem"
		ip daddr @quarantine counter drop comment "srsi-quarentena-destino"

		# 2) Ligações estabelecidas
		ct state established,related counter accept comment "srsi-estabelecidas"

		# 3) Novas ligações (protótipo: aceitar e contar)
		counter accept comment "srsi-novas"
	}
}
